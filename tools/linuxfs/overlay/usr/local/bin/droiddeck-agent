import subprocess
import sys
import threading
import time
import urllib.request
import urllib.parse
from pathlib import Path

VERSION = 1
OUTPUT_CAP = 256 * 1024
REQUEST_CAP = 256 * 1024
RESPONSE_CAP = 1024 * 1024
FOCUS_PROPS = (
    "GAMESCOPE_FOCUSED_APP", "GAMESCOPE_FOCUSED_WINDOW", "GAMESCOPE_FOCUSABLE_APPS",
    "GAMESCOPE_FOCUSABLE_WINDOWS", "GAMESCOPECTRL_BASELAYER_APPID",
)
WINDOW_PROPS = (
    "STEAM_GAME", "WM_STATE", "_NET_WM_PID", "WM_CLASS", "_NET_WM_WINDOW_OPACITY", "STEAM_OVERLAY",
    "GAMESCOPE_EXTERNAL_OVERLAY", "STEAM_INPUT_FOCUS", "_NET_WM_STATE",
)
STEAM_UI_APP = 769
FLICK_UNTIL = [0.0]  # monotonic end of a PadApply focus flick; FocusWatcher waits it out
MAP_STATE = ("unmapped", "unviewable", "viewable")
WM_STATES = {0: "withdrawn", 1: "normal", 3: "iconic"}


def log(message):
    print("== agent: " + message, flush=True)


def write_json(path, value):
    tmp = path.with_name(path.name + ".tmp")
    with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600), "w") as stream:
        os.fchmod(stream.fileno(), 0o600)
        json.dump(value, stream, separators=(",", ":"))
    os.replace(tmp, path)


class AgentError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code



class X:

    def __init__(self, display):
        num = display.lstrip(":").split(".")[0]
        last = None
        for address in ("\0/tmp/.X11-unix/X" + num, "/tmp/.X11-unix/X" + num):
            try:
                self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                self.s.settimeout(3)
                self.s.connect(address)
                break
            except OSError as e:
                last = e
                self.s.close()
        else:
            raise last
        self.s.sendall(struct.pack("<BxHHHHxx", 0x6C, 11, 0, 0, 0))
        head = self._read(8)
        if head[0] != 1:
            raise OSError("X connection refused on " + display)
        setup = self._read(struct.unpack_from("<H", head, 6)[0] * 4)
        vendor = struct.unpack_from("<H", setup, 16)[0]
        formats = setup[21]
        self.root = struct.unpack_from("<I", setup, 32 + (vendor + 3) // 4 * 4 + formats * 8)[0]
        self.events = []
        self._atoms = {}
        self._names = {}

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass

    def _read(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.s.recv(n - len(buf))
            if not chunk:
                raise OSError("X connection closed")
            buf += chunk
        return buf

    def request(self, data):
        self.s.sendall(data)
        while True:
            head = self._read(32)
            if head[0] == 0:
                return None
            if head[0] == 1:
                return head + self._read(struct.unpack_from("<I", head, 4)[0] * 4)
            self.events.append(head)

    def next_event(self):
        if self.events:
            return self.events.pop(0)
        while True:
            head = self._read(32)
            if head[0] > 1:
                return head

    def atom(self, name):
        if name not in self._atoms:
            n = name.encode()
            pad = (4 - len(n) % 4) % 4
            r = self.request(struct.pack("<BBHHxx", 16, 0, 2 + (len(n) + pad) // 4, len(n)) + n + b"\0" * pad)
            self._atoms[name] = struct.unpack_from("<I", r, 8)[0] if r else 0
        return self._atoms[name]

    def atom_name(self, atom):
        if atom not in self._names:
            r = self.request(struct.pack("<BxHI", 17, 2, atom))
            self._names[atom] = r[32:32 + struct.unpack_from("<H", r, 8)[0]].decode(errors="replace") if r else str(atom)
        return self._names[atom]

    def select(self, window, mask):
        self.s.sendall(struct.pack("<BxHIII", 2, 4, window, 0x800, mask))

    def children(self, window):
        r = self.request(struct.pack("<BxHI", 15, 2, window))
        if not r:
            return []
        n = struct.unpack_from("<H", r, 16)[0]
        return list(struct.unpack_from("<%dI" % n, r, 32))

    def attributes(self, window):
        r = self.request(struct.pack("<BxHI", 3, 2, window))
        return (r[26], r[27], struct.unpack_from("<H", r, 12)[0]) if r else None

    def geometry(self, window):
        r = self.request(struct.pack("<BxHI", 14, 2, window))
        return struct.unpack_from("<hhHH", r, 12) if r else None

    def move(self, window, x, y):
        """ConfigureWindow x/y. On a managed window the WM (gamescope) gets it as a
        ConfigureRequest, like a client moving its own window."""
        self.s.sendall(struct.pack("<BxHIHxxii", 12, 5, window, 0x3, x, y))
        self.request(struct.pack("<BxH", 43, 1))  # GetInputFocus round trip: processed

    def set_cardinals(self, window, name, values):
        """ChangeProperty (Replace) to a CARDINAL/32 list, then a round trip so it is processed."""
        atom = self.atom(name)
        if not atom:
            raise OSError("no atom " + name)
        self.s.sendall(struct.pack("<BBHIIIB3xI", 18, 0, 6 + len(values), window, atom, 6, 32, len(values))
                       + struct.pack("<%dI" % len(values), *values))
        self.request(struct.pack("<BxH", 43, 1))

    def prop(self, window, name, length=1024):
        atom = self.atom(name)
        if not atom:
            return None
        r = self.request(struct.pack("<BBHIIIII", 20, 0, 6, window, atom, 0, 0, length))
        if not r or r[1] == 0:
            return None
        fmt, n = r[1], struct.unpack_from("<I", r, 16)[0]
        data = r[32:32 + n * fmt // 8]
        if fmt == 32:
            return list(struct.unpack("<%dI" % n, data))
        return data

    def cardinals(self, window, name, values):
        self.s.sendall(struct.pack("<BBHIIIB3xI", 18, 0, 6 + len(values), window,
                                  self.atom(name), self.atom("CARDINAL"), 32, len(values))
                       + struct.pack("<%dI" % len(values), *values))

    def set_prop32(self, window, name, type_name, values):
        """ChangeProperty (Replace) to a 32-bit list of type type_name, then a round trip."""
        atom, kind = self.atom(name), self.atom(type_name)
        if not atom or not kind:
            raise OSError("no atom " + (name if not atom else type_name))
        self.s.sendall(struct.pack("<BBHIIIB3xI", 18, 0, 6 + len(values), window, atom, kind, 32, len(values))
                       + struct.pack("<%dI" % len(values), *values))
        self.request(struct.pack("<BxH", 43, 1))


def windows(x):
    out = []
    for win in x.children(x.root):
        attrs = x.attributes(win)
        if not attrs:
            continue
        props = {name: x.prop(win, name) for name in WINDOW_PROPS}
        if attrs[0] != 2 and not props["STEAM_GAME"]:
            continue
        geo = x.geometry(win) or (0, 0, 0, 0)
        cls = props["WM_CLASS"]
        state = props["WM_STATE"]
        entry = {
            "window": win,
            "map": MAP_STATE[attrs[0]] if attrs[0] < 3 else attrs[0],
            "overrideRedirect": bool(attrs[1]),
            "inputOnly": attrs[2] == 2,
            "geometry": [geo[0], geo[1], geo[2], geo[3]],
            "appId": props["STEAM_GAME"][0] if props["STEAM_GAME"] else None,
            "wmState": WM_STATES.get(state[0], state[0]) if state else None,
            "pid": props["_NET_WM_PID"][0] if props["_NET_WM_PID"] else None,
            "class": cls.split(b"\0")[-2].decode(errors="replace") if cls and b"\0" in cls else None,
        }
        if props["_NET_WM_WINDOW_OPACITY"]:
            entry["opacity"] = props["_NET_WM_WINDOW_OPACITY"][0]
        for key, name in (("overlay", "STEAM_OVERLAY"), ("externalOverlay", "GAMESCOPE_EXTERNAL_OVERLAY"),
                          ("inputFocus", "STEAM_INPUT_FOCUS")):
            if props[name]:
                entry[key] = props[name][0]
        if props["_NET_WM_STATE"]:
            entry["netState"] = [x.atom_name(a).replace("_NET_WM_STATE_", "") for a in props["_NET_WM_STATE"]]
        out.append(entry)
    return out


def displays():
    seen = []
    for d in (os.environ.get("DISPLAY"), os.environ.get("STEAM_GAME_DISPLAY_0")):
        if d and d not in seen:
            seen.append(d)
    return seen


def focus_snapshot():
    shown = displays()
    if not shown:
        raise AgentError("NO_DISPLAY", "This session has no X display")
    snap = {"t": int(time.time() * 1000), "displays": {}}
    for i, d in enumerate(shown):
        x = X(d)
        try:
            if i == 0:
                values = {name: x.prop(x.root, name) for name in FOCUS_PROPS}
                trip = values["GAMESCOPE_FOCUSABLE_WINDOWS"] or []
                snap["focusedApp"] = (values["GAMESCOPE_FOCUSED_APP"] or [None])[0]
                snap["focusedWindow"] = (values["GAMESCOPE_FOCUSED_WINDOW"] or [None])[0]
                snap["focusableApps"] = values["GAMESCOPE_FOCUSABLE_APPS"] or []
                snap["focusableWindows"] = [
                    {"window": trip[k], "appId": trip[k + 1], "pid": trip[k + 2]} for k in range(0, len(trip) - 2, 3)
                ]
                snap["baselayerAppIds"] = values["GAMESCOPECTRL_BASELAYER_APPID"] or []
            snap["displays"][d] = windows(x)
        finally:
            x.close()
    return snap


STEAM_APP_CLASS = re.compile(r"steam_app_(\d+)$")


def process_env(pid, proc=Path("/proc")):
    try:
        return dict(entry.split(b"=", 1) for entry in (proc / str(pid) / "environ").read_bytes().split(b"\0") if b"=" in entry)
    except OSError:
        return {}


def steam_app_id(env):
    try:
        app = int(env.get(b"SteamAppId", b"0"))
    except ValueError:
        return None
    return app if 0 < app < 2**32 else None


def reaper_launch_id(pid, proc=Path("/proc")):
    try:
        args = (proc / str(pid) / "cmdline").read_bytes().split(b"\0")[1:]
    except OSError:
        return None
    launch, app = False, 0
    for arg in args:
        if arg == b"--":
            break
        if arg == b"SteamLaunch":
            launch = True
        elif arg.startswith(b"AppId="):
            try:
                app = int(arg[6:]) or app
            except ValueError:
                pass
    return app if launch else 0


def reaper_launch(pid, proc=Path("/proc")):
    found = None
    for _ in range(64):
        try:
            if (proc / str(pid) / "comm").read_text().strip() == "reaper":
                launched = reaper_launch_id(pid, proc)
                if launched is None or found is False:
                    found = False
                elif launched or found is None:
                    found = launched
            stat = (proc / str(pid) / "stat").read_text()
            pid = int(stat[stat.rindex(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            return found
        if pid <= 1:
            return found
    return found


def sandboxed_apps(proc=Path("/proc")):
    apps = {}
    try:
        pids = [entry for entry in os.listdir(proc) if entry.isdigit()]
    except OSError:
        return apps
    for pid in pids:
        env = process_env(pid, proc)
        flatpak, app = env.get(b"FLATPAK_ID"), steam_app_id(env)
        if flatpak and app:
            name = flatpak.decode(errors="replace").lower()
            for key in {name, name.rsplit(".", 1)[-1]}:
                apps[key] = app if apps.get(key, app) == app else None
    return apps


def ancestry(pid, proc=Path("/proc"), limit=12):
    """'pid comm < parent comm < ...' for the decision log; a reaper shows its launch id."""
    parts = []
    for _ in range(limit):
        try:
            comm = (proc / str(pid) / "comm").read_text().strip()
            if comm == "reaper":
                launched = reaper_launch_id(pid, proc)
                comm = "reaper[%s]" % ("?" if launched is None else "AppId=%d" % launched if launched else "bare")
            parts.append("%d %s" % (pid, comm))
            stat = (proc / str(pid) / "stat").read_text()
            pid = int(stat[stat.rindex(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            parts.append("%s ?" % pid)
            break
        if pid <= 1:
            parts.append("%d" % pid)
            break
    return " < ".join(parts)


def window_steam_app(win, flatpaks, proc=Path("/proc")):
    """The app id to tag the window with, or None, and the reason."""
    cls = win.get("class") or ""
    match = STEAM_APP_CLASS.match(cls)
    if match and os.environ.get("BL_STEAM_CLIENT_ARCH") == "x86_64":
        return match.group(1), "x86-64 client, class %s" % cls
    pid = win.get("pid")
    if pid:
        launched = reaper_launch(pid, proc)
        # Proton names every window steam_app_<SteamAppId>, so on the arm64 client the class gives the id too.
        app = steam_app_id(process_env(pid, proc)) or (steam_app_id({b"SteamAppId": match.group(1).encode()}) if match else None)
        if launched is False:
            return None, "a reaper above it has no readable cmdline"
        if app == STEAM_UI_APP:
            return None, "Steam's own app id 769"
        if app and launched == app:
            return None, "under its own launch reaper AppId=%d, gamescope resolves it" % app
        if app:
            # A window opened after its launch's reaper died (Ubisoft Connect starting the game) sits under
            # another reaper or none, so gamescope gives it that reaper's id (769 or none) instead of its own.
            return str(app), ("no reaper above it" if launched is None
                              else "under reaper AppId=%s, not its own" % (launched or "none (bare)"))
        if launched is not None:
            return None, "no SteamAppId in its process"
    elif match:
        return None, "class %s but no _NET_WM_PID" % cls
    app = flatpaks().get(cls.lower())
    if app:
        return str(app), "sandboxed app %s" % cls
    return None, "no SteamAppId, no reaper, no sandboxed app match"


TAG_DECISIONS = {}


def tag_game_windows(snap, proc=Path("/proc")):
    """Tag game-display windows gamescope cannot give an app id. Every decision on a viewable managed
    window is logged once (and again when it changes), so a session log shows why a window was or
    was not tagged."""
    tagged = False
    found = []
    seen = set()

    def flatpaks():
        if not found:
            found.append(sandboxed_apps(proc))
        return found[0]

    def note(display, win, decision):
        key = (display, win["window"])
        seen.add(key)
        if TAG_DECISIONS.get(key) == decision:
            return False
        TAG_DECISIONS[key] = decision
        return True

    for display, wins in snap.get("displays", {}).items():
        if display == os.environ.get("DISPLAY"):
            continue
        for win in wins:
            if win.get("map") != "viewable" or win.get("overrideRedirect") or win.get("inputOnly"):
                continue
            pid = win.get("pid")
            label = "game window 0x%x on %s (class %s, pid %s)" % (win["window"], display, win.get("class"), pid)
            if win.get("appId"):
                if note(display, win, ("has", win["appId"])):
                    log("%s skipped: already has STEAM_GAME=%s" % (label, win["appId"]))
                continue
            app, reason = window_steam_app(win, flatpaks, proc)
            if not app:
                if note(display, win, ("skip", reason)):
                    log("%s skipped: %s; chain %s" % (label, reason, ancestry(pid, proc) if pid else "-"))
                continue
            note(display, win, ("tag", app))
            try:
                done = subprocess.run(["xprop", "-display", display, "-id", str(win["window"]), "-f", "STEAM_GAME", "32c",
                                       "-set", "STEAM_GAME", app],
                                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5).returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                done = False
            log("%s tagged STEAM_GAME=%s: %s (%s; chain %s)" % (label, app, "ok" if done else "failed", reason,
                                                               ancestry(pid, proc) if pid else "-"))
            tagged = tagged or done
    for key in [key for key in TAG_DECISIONS if key not in seen]:
        del TAG_DECISIONS[key]
    return tagged


def vr_scene_app(path=Path('/run/droiddeck/droiddeck-steamvr/scene-focus.json'), proc=Path('/proc')):
    try:
        state = json.loads(path.read_text())
        server, scene = int(state['serverPid']), int(state['scenePid'])
        if server <= 0 or scene <= 0 or state['dashboard'] is not False:
            return None
        if (proc / str(server) / 'comm').read_text().strip() != 'vrserver':
            return None
        for entry in (proc / str(scene) / 'environ').read_bytes().split(b'\0'):
            if entry.startswith(b'SteamAppId='):
                app = int(entry.split(b'=', 1)[1])
                return app if 0 < app < 2**32 else None
    except (OSError, ValueError, TypeError, KeyError):
        pass
    return None


class VrSceneFocus:
    def __init__(self):
        self.original = None
        self.written = None

    def order(self, current, focusable, app):
        if app is None or app not in focusable:
            restore = self.original if self.written == current else None
            self.original = self.written = None
            return restore
        if current and current[0] == app:
            return None
        if self.original is None:
            self.original = list(current)
        self.written = [app] + [item for item in current if item != app]
        return self.written


def pid_alive(pid, proc=Path("/proc")):
    try:
        stat = (proc / str(pid) / "stat").read_text()
        return stat[stat.rindex(")") + 2:].split()[0] not in ("Z", "X")
    except (OSError, ValueError, IndexError):
        return False


def steam_shows_itself_first(baselayer, app):
    """True when Steam's base layer does not put the app before its own UI: Steam no longer runs it."""
    if app not in baselayer:
        return True
    return STEAM_UI_APP in baselayer and baselayer.index(STEAM_UI_APP) < baselayer.index(app)


class FocusReassert:
    """Opt-in (BL_FOCUS_REASSERT=1, off by default): bring back a game whose launch Steam lost.

    When the Steam launch chain of a Ubisoft/Epic shortcut is killed early (`Killed`, `game stopped`), Steam
    keeps its own UI first in GAMESCOPECTRL_BASELAYER_APPID although the game lives on. Its window is tagged
    (tag_game_windows) but never focused, so it stays minimized (WM_STATE Iconic) and DXVK never gets a
    swap chain (0x0 extent): no frame, Steam home in front (wd2-perf2-0436 L2). For a viewable, STEAM_GAME-tagged
    window on a game display that is Iconic, whose process lives, has no launch reaper with its own app id
    above it, and whose app Steam does not put before 769, this
      1. sets WM_STATE Normal on the window (what gamescope does when it focuses a window),
      2. writes the base layer with the app first, Steam's other entries after it,
      3. sets GAMESCOPECTRL_BASELAYER_WINDOW to the window (gamescope then focuses exactly this window, not a
         later-mapped launcher window of the same app), and asks gamescope to restore its focus window,
    at most TRIES times per window, GAP seconds apart. The window control is released (old value back) when the
    window is gone or its process died. Every action is logged."""

    TRIES = 3
    GAP = 10.0
    CONTROL = "GAMESCOPECTRL_BASELAYER_WINDOW"

    def __init__(self, clock=time.monotonic):
        self.clock = clock
        self.tries = {}
        self.control = None  # (display, window, pid, original value list)

    @staticmethod
    def enabled():
        return os.environ.get("BL_FOCUS_REASSERT") == "1"

    def candidates(self, snap, proc=Path("/proc")):
        out = []
        baselayer = list(snap.get("baselayerAppIds") or [])
        for display, wins in snap.get("displays", {}).items():
            if display == os.environ.get("DISPLAY"):
                continue
            for win in wins:
                app, pid = win.get("appId"), win.get("pid")
                if (win.get("map") != "viewable" or win.get("overrideRedirect") or win.get("inputOnly")
                        or not app or app == STEAM_UI_APP or win.get("wmState") != "iconic" or not pid):
                    continue
                if not pid_alive(pid, proc):
                    continue
                launched = reaper_launch(pid, proc)
                if launched is False or launched == app:
                    continue  # Steam still runs it (its own launch reaper), or the chain is unreadable
                if not steam_shows_itself_first(baselayer, app):
                    continue
                out.append((display, win, app, pid, launched))
        return out

    def plan(self, snap, proc=Path("/proc")):
        """The actions for this snapshot: ("release", display, window, original) and
        ("restore", display, window, app, pid, order, why)."""
        actions = []
        now = self.clock()
        if self.control:
            display, window, pid, original = self.control
            live = any(w.get("window") == window for w in snap.get("displays", {}).get(display, []))
            if not live or not pid_alive(pid, proc):
                actions.append(("release", display, window, original,
                                "window gone" if not live else "process %s gone" % pid))
                self.control = None
        shown = {(d, w["window"]) for d, wins in snap.get("displays", {}).items() for w in wins if w.get("window")}
        self.tries = {k: v for k, v in self.tries.items() if k in shown}
        baselayer = list(snap.get("baselayerAppIds") or [])
        for display, win, app, pid, launched in self.candidates(snap, proc):
            key = (display, win["window"])
            count, last = self.tries.get(key, (0, None))
            if count >= self.TRIES or (last is not None and now - last < self.GAP):
                continue
            self.tries[key] = (count + 1, now)
            order = [app] + [item for item in baselayer if item != app]
            why = "Iconic, pid %s alive, %s, base layer %s" % (
                pid, "no reaper above it" if launched is None else "under reaper AppId=%s, not its own" % (launched or "none (bare)"),
                baselayer)
            actions.append(("restore", display, win["window"], app, pid, order, why, count + 1))
            break  # one window per snapshot
        return actions

    def apply(self, actions):
        steam = os.environ.get("DISPLAY")
        for action in actions:
            if action[0] == "release":
                _, display, window, original, why = action
                try:
                    x = X(steam)
                    try:
                        x.set_prop32(x.root, self.CONTROL, "CARDINAL", original or [0])
                    finally:
                        x.close()
                    log("focus reassert: released %s (was 0x%x on %s, %s; back to %s)"
                        % (self.CONTROL, window, display, why, original or [0]))
                except OSError as e:
                    log("focus reassert: release of 0x%x failed: %s" % (window, e))
                continue
            _, display, window, app, pid, order, why, attempt = action
            steps = []
            try:
                x = X(display)
                try:
                    x.set_prop32(window, "WM_STATE", "WM_STATE", [1, 0])
                    steps.append("WM_STATE Normal on 0x%x" % window)
                finally:
                    x.close()
                x = X(steam)
                try:
                    x.set_prop32(x.root, "GAMESCOPECTRL_BASELAYER_APPID", "CARDINAL", order)
                    steps.append("base layer %s" % order)
                    if self.control is None:
                        original = x.prop(x.root, self.CONTROL) or [0]
                    else:
                        original = self.control[3]
                    x.set_prop32(x.root, self.CONTROL, "CARDINAL", [window])
                    self.control = (display, window, pid, original)
                    steps.append("%s 0x%x (was %s)" % (self.CONTROL, window, original))
                finally:
                    x.close()
                for d in (steam, display):
                    x = X(d)
                    try:
                        x.set_prop32(x.root, "GAMESCOPE_RESTORE_FOCUS_WINDOW", "CARDINAL", [1])
                    finally:
                        x.close()
                steps.append("restore request")
                log("focus reassert #%d: game window 0x%x on %s (app %s): %s; did: %s"
                    % (attempt, window, display, app, why, ", ".join(steps)))
            except OSError as e:
                log("focus reassert #%d: game window 0x%x on %s (app %s): %s; failed after [%s]: %s"
                    % (attempt, window, display, app, why, ", ".join(steps), e))


WEBHELPER_EVENTS = []  # (monotonic s, what): Steam's web helper page crashed or its DevTools went away
WEBHELPER_TROUBLE = ("Target crashed", "closed the connection", "Connection refused")


def note_webhelper_trouble(error, clock=time.monotonic):
    """KeyboardWatcher's DevTools errors, the same ones that reach session.log ("Target crashed" and the
    lost DevTools connection when steamwebhelper dies): evidence for FocusGuard that Steam's UI reloaded."""
    text = str(error)
    what = next((w for w in WEBHELPER_TROUBLE if w in text), None)
    if what:
        WEBHELPER_EVENTS.append((clock(), "Steam keyboard: " + what))
        del WEBHELPER_EVENTS[:-16]
    return what is not None


def webhelper_browsers(proc=Path("/proc")):
    """The steamwebhelper browser processes (not its --type= children): a new pid means the web helper restarted."""
    pids = set()
    try:
        entries = [e for e in os.listdir(proc) if e.isdigit()]
    except OSError:
        return pids
    for entry in entries:
        try:
            if (proc / entry / "comm").read_text().strip() != "steamwebhelper":
                continue
            args = (proc / entry / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        if not any(arg.startswith(b"--type=") for arg in args):
            pids.add(int(entry))
    return pids


def read_menu_press(path):
    """libfakeinput's last user Guide/QAM press: (CLOCK_MONOTONIC seconds, button) or None."""
    try:
        ms, _, button = path.read_text().strip().partition(" ")
        return int(ms) / 1000.0, button or "?"
    except (OSError, ValueError):
        return None


def read_stamp(path):
    """The app's last real user input on the session screen (session/InputStamps `user`): CLOCK_MONOTONIC s or None."""
    try:
        return int(path.read_text().strip()) / 1000.0
    except (OSError, ValueError):
        return None


def read_agent_windows(path):
    """The app's windows of agent-injected input (session/InputStamps `agent`, "<start ms> <end ms>" lines), in s."""
    windows = []
    try:
        for line in path.read_text().splitlines():
            start, _, end = line.partition(" ")
            windows.append((int(start) / 1000.0, int(end) / 1000.0))
    except (OSError, ValueError):
        pass
    return windows


def guard_order(baselayer, app):
    """Steam's own layout while a game runs: the game right before the Steam UI ([413091, app, 769])."""
    rest = [item for item in baselayer if item != app]
    if STEAM_UI_APP in rest:
        at = rest.index(STEAM_UI_APP)
        return rest[:at] + [app] + rest[at:]
    return [app] + rest


class FocusGuard:
    """Puts a running game back in front when Steam's UI reloads and takes the front by itself.

    Measured (wd1-vivoboost-0800 L1, upstream-rebase-1102 § 20): steamwebhelper crashed under memory pressure
    ("Target crashed", DevTools gone), the reloaded Steam UI took the focus (769) and rebuilt the base layer
    without the game ([413091, 769]) although the game and its launch reaper lived on. FocusReassert skips such a
    game (its own reaper is alive), so this guard handles it. It acts only when all of these hold:
      - the game was in front (GAMESCOPE_FOCUSED_APP) for HOLD_MIN s; its window still exists and its process lives;
      - it runs on the Mali bridge (its environment has ENABLE_MALI_COMPAT/ENABLE_MALI_WSI=1), or BL_FOCUS_GUARD=1
        (the agent's or the game's environment); BL_FOCUS_GUARD=0 in either turns it off;
      - Steam now has the focus (769) and Steam's base layer no longer lists the game. When the user opens the
        Steam menu or the QAM over a game, Steam keeps the game in its base layer, behind itself
        ([413091, 769, app]); that is left alone;
      - no user Guide/QAM press (libfakeinput's .padapply/menu stamp) from MENU_LEAD s before Steam took the front
        on: then the front is the user's choice;
      - a reload is evidenced within EVIDENCE_WINDOW s: a web helper crash seen by the Steam keyboard watcher
        (the session log's "Target crashed"/lost DevTools lines), a new steamwebhelper browser pid, or a Steam
        window remap (a window or window pid on Steam's display that was not there while the game was in front).
        Without it (a quit from Steam's menu also drops the game) nothing is done.
    Launch phase (w3-uncap L1, 11-05 16:02:45: Witcher 3 was in front 4 s, then Steam took the front, first without
    the game in its base layer, then with it behind itself, no press and no reload; the game stayed behind until the
    quit): for LAUNCH_SPAN s after a game first came to front, Steam in front is not the user's choice unless the
    user pressed Guide/QAM since the game appeared, or gave real input (touch, a pad, a keyboard: the app's
    .padapply/user stamp) on Steam's UI after it took the front. Then neither reload evidence nor the game still
    being in the base layer is needed.
    Reload span (wd2-uncap-1535, 16:32:22/16:33:02 web helper OOM kills: the guard put WD2 back at 16:32:26, Steam
    took the front again at 16:32:28 with WD2 behind it in the base layer and was left alone as "Steam's menu"):
    while a reload episode is open, or reload evidence is at most RELOAD_SPAN s older than the steal, Steam in front
    with the game still in its base layer is the reload's too (the user check above still wins).
    Synthetic input is not the user's: a Guide/QAM stamp that falls inside an agent input window (the app's
    .padapply/agent, droiddeckctl input) is dropped; `adb shell input keyevent` never reaches the user stamp.
    Steam in front right after such a press is the tool's menu: left alone (the focus steps cannot close an open
    Steam menu; rc2fix-retest-1105 F1b), and it does not count as the user's press for later steals.
    Then, with the same steps as FocusReassert, it sets WM_STATE Normal on the game window, writes the base
    layer as Steam does while a game runs (the game before 769), sets GAMESCOPECTRL_BASELAYER_WINDOW to the
    window and asks gamescope to restore its focus window: at most TRIES times per reload, BACKOFF s apart. The
    window control is released when the game was back in front for PIN_HOLD s, at a user Guide/QAM press, when
    Steam itself puts 769 before the game, or when the window or process is gone. Every decision is logged."""

    TRIES = 3
    BACKOFF = (2.0, 4.0, 8.0)  # before try 1 (after Steam took the front), 2 and 3 (after the try before)
    HOLD_MIN = 3.0
    MENU_LEAD = 2.0
    LAUNCH_SPAN = 300.0   # a game's launch phase, from the first time it was in front
    RELOAD_SPAN = 120.0   # after reload evidence or an open reload episode, every front steal in this span is the reload's
    USER_LAG = 0.3        # real input this long after Steam took the front was on Steam's UI
    AGENT_SLACK = (0.5, 1.5)  # a menu stamp this close before/after an agent input window is that input's
    EVIDENCE_WINDOW = 300.0
    EPISODE_SPAN = 60.0  # back in front this long after the last try: the reload is over
    PIN_HOLD = 20.0
    BROWSER_EVERY = 5.0
    CONTROL = "GAMESCOPECTRL_BASELAYER_WINDOW"

    def __init__(self, clock=time.monotonic, proc=Path("/proc"), menu_press=None, events=None, browsers=None,
                 user_input=None, agent_windows=None):
        self.clock = clock
        self.proc = proc
        evdev = os.environ.get("FAKE_EVDEV_DIR")
        pad = Path(evdev) / ".padapply" if evdev else None
        self.menu_press = menu_press or ((lambda: read_menu_press(pad / "menu")) if pad else (lambda: None))
        self.user_input = user_input or ((lambda: read_stamp(pad / "user")) if pad else (lambda: None))
        self.agent_windows = agent_windows or ((lambda: read_agent_windows(pad / "agent")) if pad else (lambda: []))
        self.launch = {}      # app -> when it first came to front (its launch phase)
        self.synthetic = None  # the last menu stamp dropped as agent input
        self.tool_menu = None  # that stamp, while it is the newest one: our tools opened Steam's menu
        self.events = WEBHELPER_EVENTS if events is None else events
        self.browsers = browsers or (lambda: webhelper_browsers(self.proc))
        self.held = None      # the game last in front: app, display, window, pid, since, seen, steam, on, why
        self.away = None      # Steam in front since: since, noted
        self.episode = None   # one reload: opened, tries, last, back
        self.pin = None       # display, window, pid, original, at, back
        self.seen = []        # own evidence: (t, what)
        self.spent = float("-inf")
        self.known_browsers = None
        self.browsers_at = None
        self.wake = None

    @staticmethod
    def off():
        return os.environ.get("BL_FOCUS_GUARD") == "0"

    def enabled_for(self, pid):
        if os.environ.get("BL_FOCUS_GUARD") == "0":
            return False, "BL_FOCUS_GUARD=0"
        env = process_env(pid, self.proc)
        own = env.get(b"BL_FOCUS_GUARD")
        if own == b"0":
            return False, "the game's BL_FOCUS_GUARD=0"
        if os.environ.get("BL_FOCUS_GUARD") == "1" or own == b"1":
            return True, "BL_FOCUS_GUARD=1"
        if env.get(b"ENABLE_MALI_COMPAT") == b"1" or env.get(b"ENABLE_MALI_WSI") == b"1":
            return True, "on the Mali bridge"
        return False, "not on the Mali bridge (BL_FOCUS_GUARD=1 turns it on)"

    @staticmethod
    def steam_windows(snap):
        return {(w.get("window"), w.get("pid")) for w in snap.get("displays", {}).get(os.environ.get("DISPLAY"), [])
                if w.get("map") == "viewable" and not w.get("overrideRedirect") and not w.get("inputOnly")}

    @staticmethod
    def game_window(snap, app):
        """(display, window entry, pid) of the app's window in front: gamescope's focused window, else the
        largest viewable window tagged STEAM_GAME=app, on a game display."""
        steam = os.environ.get("DISPLAY")
        triplets = {f.get("window"): f.get("pid") for f in snap.get("focusableWindows", [])}
        best = None
        for display, wins in snap.get("displays", {}).items():
            if display == steam:
                continue
            for win in wins:
                if win.get("map") != "viewable" or win.get("overrideRedirect") or win.get("inputOnly"):
                    continue
                pid = win.get("pid") or triplets.get(win.get("window"))
                if win.get("window") == snap.get("focusedWindow") and pid:
                    return display, win, pid
                if win.get("appId") == app and pid:
                    area = win.get("geometry", [0, 0, 0, 0])[2] * win.get("geometry", [0, 0, 0, 0])[3]
                    if best is None or area > best[0]:
                        best = (area, display, win, pid)
        return best[1:] if best else None

    @staticmethod
    def find(snap, display, window):
        return next((w for w in snap.get("displays", {}).get(display, []) if w.get("window") == window), None)

    def user_menu(self):
        """libfakeinput's last Guide/QAM stamp, unless it was our tools' input (an agent input window)."""
        menu = self.menu_press()
        self.tool_menu = None
        if not menu:
            return None
        before, after = self.AGENT_SLACK
        for start, end in self.agent_windows():
            if start - before <= menu[0] <= end + after:
                if self.synthetic != menu:
                    self.synthetic = menu
                    log("focus guard: %s press at %.1f is agent input (window %.1f-%.1f); not the user's"
                        % (menu[1], menu[0], start, end))
                self.tool_menu = menu
                return None
        return menu

    def note(self, key, message):
        if self.away is not None:
            if key in self.away["noted"]:
                return
            self.away["noted"].add(key)
        log("focus guard: " + message)

    def evidence(self, now):
        """Reload evidence newer than the last reload already handled, within EVIDENCE_WINDOW."""
        floor = max(self.spent, (self.away["since"] if self.away else now) - self.EVIDENCE_WINDOW)
        return [e for e in list(self.events) + self.seen if e[0] >= floor]

    def sample_browsers(self, now):
        if self.browsers_at is not None and now - self.browsers_at < self.BROWSER_EVERY:
            return
        self.browsers_at = now
        pids = self.browsers()
        if self.known_browsers and pids and not pids & self.known_browsers:
            self.seen.append((now, "steamwebhelper restarted (browser pid %s -> %s)"
                              % (sorted(self.known_browsers), sorted(pids))))
        elif self.known_browsers and not pids:
            self.seen.append((now, "steamwebhelper gone (browser pid %s)" % sorted(self.known_browsers)))
        if pids or self.known_browsers is None:
            self.known_browsers = pids
        del self.seen[:-16]

    def plan(self, snap):
        """The actions for this snapshot: ("release", display, window, original, why) and
        ("restore", display, window, app, pid, order, why, attempt, wm_state)."""
        now = self.clock()
        self.wake = None
        actions = []
        focused = snap.get("focusedApp")
        baselayer = list(snap.get("baselayerAppIds") or [])
        menu = self.user_menu()
        held = self.held
        if self.pin:
            pin = self.pin
            win = self.find(snap, pin["display"], pin["window"])
            why = None
            if win is None:
                why = "window gone"
            elif not pid_alive(pin["pid"], self.proc):
                why = "process %s gone" % pin["pid"]
            elif menu and menu[0] > pin["at"]:
                why = "user %s press" % menu[1]
            elif self.tool_menu and self.tool_menu[0] > pin["at"]:
                why = "agent %s press" % self.tool_menu[1]
            elif (held and held["app"] in baselayer and STEAM_UI_APP in baselayer
                  and baselayer.index(STEAM_UI_APP) < baselayer.index(held["app"])):
                why = "Steam put itself before the game %s" % baselayer
            elif pin["back"] is not None and now - pin["back"] >= self.PIN_HOLD:
                why = "game back in front for %.0f s" % (now - pin["back"])
            if why:
                actions.append(("release", pin["display"], pin["window"], pin["original"], why))
                self.pin = None
        if focused and focused != STEAM_UI_APP:
            found = self.game_window(snap, focused)
            if not found:
                return actions
            display, win, pid = found
            if focused not in self.launch:
                self.launch[focused] = now
            if held is None or (held["app"], held["window"], held["pid"]) != (focused, win["window"], pid):
                on, why = self.enabled_for(pid)
                held = self.held = {"app": focused, "display": display, "window": win["window"], "pid": pid,
                                    "since": now, "on": on, "why": why}
                log("focus guard: %s app %s, window 0x%x on %s, pid %s (%s)"
                    % ("watching" if on else "not watching", focused, win["window"], display, pid, why))
            held["seen"] = now
            held["steam"] = self.steam_windows(snap)
            if held["on"]:
                self.sample_browsers(now)
            self.away = None
            ep = self.episode
            if ep and ep["app"] == focused:
                if ep["back"] is None:
                    ep["back"] = now
                    log("focus guard: app %s back in front after try %d" % (focused, ep["tries"]))
                    if self.pin and self.pin["window"] == win["window"]:
                        self.pin["back"] = now
                elif ep["last"] is not None and now - ep["last"] >= self.EPISODE_SPAN:
                    log("focus guard: app %s stayed in front %.0f s after the last try; reload handled"
                        % (focused, now - ep["last"]))
                    self.episode = None
                    self.spent = now
            return actions
        if held is None or not held["on"]:
            return actions
        app = held["app"]
        win = self.find(snap, held["display"], held["window"])
        if win is None or not pid_alive(held["pid"], self.proc):
            if self.episode or self.away:
                log("focus guard: app %s %s; stopped" % (app, "window gone" if win is None else "process gone"))
            self.held = self.away = self.episode = None
            self.launch.pop(app, None)
            return actions
        if self.away is None:
            self.away = {"since": now, "noted": set()}
            if self.episode:
                self.episode["back"] = None
        away = self.away
        self.sample_browsers(now)
        changed = self.steam_windows(snap) ^ held.get("steam", set())
        if changed and "remap" not in away:
            away["remap"] = True
            self.seen.append((now, "Steam window remap %s" % sorted(
                "0x%x/%s" % (w or 0, p) for w, p in changed)))
        if focused != STEAM_UI_APP:
            self.note("focus", "focus left app %s for %s; not Steam's UI, left alone" % (app, focused))
            return actions
        user = self.user_input()
        if user is not None and user >= away["since"] + self.USER_LAG:
            self.note("touch", "Steam in front, then the user's own input on its UI; left alone")
            if self.episode:
                log("focus guard: reload handling for app %s ends at the user's input on Steam" % app)
                self.episode = None
                self.spent = now
            return actions
        tool = self.tool_menu
        if tool and tool[0] >= away["since"] - self.MENU_LEAD:
            # rc2fix-retest-1105 F1b: droiddeckctl's QAM opened Steam's overlay ([413091, app, 769], only the game
            # focusable); the focus steps cannot close an open Steam menu, so 3 tries only fought our own tool.
            # Not the user's choice (later steals still count as steals), but the tool's: it closes what it opened.
            self.note("tool", "Steam in front after our tools' %s press (agent input); left to the tool, "
                      "not counted as the user's" % tool[1])
            return actions
        first = self.launch.get(app)
        launch = (first is not None and away["since"] - first <= self.LAUNCH_SPAN
                  and not (menu and menu[0] >= first - self.MENU_LEAD))
        if held["seen"] - held["since"] < self.HOLD_MIN and self.episode is None and not launch:
            self.note("short", "app %s was in front only %.1f s; left alone" % (app, held["seen"] - held["since"]))
            return actions
        if menu and menu[0] >= away["since"] - self.MENU_LEAD:
            self.note("user", "Steam in front after a user %s press; left alone" % menu[1])
            if self.episode:
                log("focus guard: reload handling for app %s ends at the user's %s press" % (app, menu[1]))
                self.episode = None
                self.spent = now
            return actions
        if launch:
            evidence = [(away["since"], "launch phase: Steam took the front %.0f s after app %s first came to front, "
                         "no user Guide/QAM press since and no input on Steam's UI" % (away["since"] - first, app))]
        elif app in baselayer and self.episode is None and not [
                e for e in self.evidence(now) if e[0] >= away["since"] - self.RELOAD_SPAN]:
            self.note("menu", "Steam in front, app %s still in its base layer %s (Steam's menu over the game); "
                      "left alone" % (app, baselayer))
            return actions
        else:
            evidence = self.evidence(now)
        if not evidence and self.episode is None:
            self.note("quiet", "Steam in front and app %s dropped from its base layer %s, but no web helper crash "
                      "or Steam window remap (a quit?); left alone" % (app, baselayer))
            return actions
        ep = self.episode
        if ep is None or ep["app"] != app:
            ep = self.episode = {"app": app, "opened": now, "tries": 0, "last": None, "back": None}
            self.spent = now
            launched = reaper_launch(held["pid"], self.proc)
            log("focus guard: Steam took the front from app %s (window 0x%x on %s, pid %s alive, %s; %s) without "
                "a Guide/QAM press; base layer %s, focusable %s; evidence: %s"
                % (app, held["window"], held["display"], held["pid"],
                   "its launch reaper alive" if launched == app else "reaper %s" % launched, held["why"], baselayer,
                   snap.get("focusableApps"), "; ".join("%s (%.0f s ago)" % (w, now - t) for t, w in evidence[-4:])))
        if ep["tries"] >= self.TRIES:
            self.note("spent", "app %s still behind Steam after %d tries; giving up for this reload" % (app, self.TRIES))
            return actions
        due = away["since"] + self.BACKOFF[0]
        if ep["last"] is not None:
            due = max(due, ep["last"] + self.BACKOFF[min(ep["tries"], len(self.BACKOFF) - 1)])
        if now < due:
            self.wake = due
            return actions
        ep["tries"] += 1
        ep["last"] = now
        order = guard_order(baselayer, app)
        why = "Steam in front %.1f s, base layer %s, wmState %s" % (now - away["since"], baselayer, win.get("wmState"))
        actions.append(("restore", held["display"], held["window"], app, held["pid"], order, why, ep["tries"],
                        win.get("wmState")))
        if ep["tries"] < self.TRIES:
            self.wake = now + self.BACKOFF[ep["tries"]]
        return actions

    def apply(self, actions, control_busy=False):
        steam = os.environ.get("DISPLAY")
        for action in actions:
            if action[0] == "release":
                _, display, window, original, why = action
                try:
                    x = X(steam)
                    try:
                        x.set_prop32(x.root, self.CONTROL, "CARDINAL", original or [0])
                    finally:
                        x.close()
                    log("focus guard: released %s (was 0x%x on %s, %s; back to %s)"
                        % (self.CONTROL, window, display, why, original or [0]))
                except OSError as e:
                    log("focus guard: release of 0x%x failed: %s" % (window, e))
                continue
            _, display, window, app, pid, order, why, attempt, wm_state = action
            steps = []
            try:
                x = X(display)
                try:
                    x.set_prop32(window, "WM_STATE", "WM_STATE", [1, 0])
                    steps.append("WM_STATE Normal on 0x%x (was %s)" % (window, wm_state))
                finally:
                    x.close()
                x = X(steam)
                try:
                    x.set_prop32(x.root, "GAMESCOPECTRL_BASELAYER_APPID", "CARDINAL", order)
                    steps.append("base layer %s" % order)
                    if control_busy:
                        steps.append("%s left to focus reassert" % self.CONTROL)
                    else:
                        original = self.pin["original"] if self.pin else (x.prop(x.root, self.CONTROL) or [0])
                        x.set_prop32(x.root, self.CONTROL, "CARDINAL", [window])
                        self.pin = {"display": display, "window": window, "pid": pid, "original": original,
                                    "at": self.clock(), "back": None}
                        steps.append("%s 0x%x (was %s)" % (self.CONTROL, window, original))
                finally:
                    x.close()
                for d in (steam, display):
                    x = X(d)
                    try:
                        x.set_prop32(x.root, "GAMESCOPE_RESTORE_FOCUS_WINDOW", "CARDINAL", [1])
                    finally:
                        x.close()
                steps.append("restore request")
                log("focus guard try %d/%d: game window 0x%x on %s (app %s, pid %s): %s; did: %s"
                    % (attempt, self.TRIES, window, display, app, pid, why, ", ".join(steps)))
            except OSError as e:
                log("focus guard try %d/%d: game window 0x%x on %s (app %s, pid %s): %s; failed after [%s]: %s"
                    % (attempt, self.TRIES, window, display, app, pid, why, ", ".join(steps), e))


class FocusWatcher(threading.Thread):

    def __init__(self, path):
        super().__init__(daemon=True, name="focus")
        self.path = path
        self.changed = threading.Event()
        self.last = None
        self.seq = 0
        self.vr_focus = VrSceneFocus()
        self.reassert = FocusReassert()
        self.guard = FocusGuard()
        self.nudged = {}

    NUDGE_TRIES = 3

    def nudge_dialog(self, snap):
        """Wine maps a launcher dialog (Oblivion's, or a message box) that gamescope still caches
        as override-redirect, so it is missing from GAMESCOPE_FOCUSABLE_WINDOWS and stays hidden
        behind Steam without input. A move makes gamescope re-read the flag from ConfigureNotify.
        Move such a window (viewable, managed, not Steam's, smaller than the screen, not focusable)
        by one pixel and back, up to NUDGE_TRIES times. BL_NUDGE_DIALOGS=0 turns this off."""
        if os.environ.get("BL_NUDGE_DIALOGS", "1") == "0":
            return
        shown = snap.get("displays", {})
        existing = {(d, e["window"]) for d, wins in shown.items() for e in wins}
        self.nudged = {k: n for k, n in self.nudged.items() if k in existing}
        focusable = {(f.get("window"), f.get("pid")) for f in snap.get("focusableWindows", [])}

        def is_focusable(entry):
            return any(win == entry["window"] and (not pid or not entry.get("pid") or pid == entry["pid"])
                       for win, pid in focusable)

        for d, wins in shown.items():
            candidates = [
                e for e in wins
                if e.get("window") and self.nudged.get((d, e["window"]), 0) < self.NUDGE_TRIES
                and e.get("map") == "viewable" and not e.get("overrideRedirect") and not e.get("inputOnly")
                and e.get("appId") != 769 and not is_focusable(e)
            ]
            if not candidates:
                continue
            x = X(d)
            try:
                root = x.geometry(x.root)
                if not root:
                    continue
                for entry in candidates:
                    win = entry["window"]
                    gx, gy, w, h = entry.get("geometry", (0, 0, 0, 0))
                    if w <= 1 or h <= 1 or (w >= root[2] and h >= root[3]):
                        continue
                    tries = self.nudged.get((d, win), 0) + 1
                    self.nudged[(d, win)] = tries
                    try:
                        x.move(win, gx + 1, gy + 1)
                        time.sleep(0.15)
                        x.move(win, gx, gy)
                        log("nudged dialog window 0x%x (app %s, %dx%d) on %s, try %d"
                            % (win, entry.get("appId"), w, h, d, tries))
                    except OSError as e:
                        log("failed to nudge window 0x%x: %s" % (win, e))
            finally:
                x.close()

    def run(self):
        threading.Thread(target=self.listen, daemon=True, name="focus-events").start()
        last_app, last_snapshot = None, 0
        while True:
            notified = self.changed.wait(timeout=0.5)
            self.changed.clear()
            app = vr_scene_app()
            due = self.guard.wake is not None and time.monotonic() >= self.guard.wake
            if not notified and not due and app == last_app and time.monotonic() - last_snapshot < 5:
                continue
            last_app, last_snapshot = app, time.monotonic()
            time.sleep(0.2)
            while time.monotonic() < FLICK_UNTIL[0]:
                # PadApply's focus flick: not a real focus change, keep it out of focus.json.
                time.sleep(0.05)
                self.changed.clear()
            try:
                snap = focus_snapshot()
                order = self.vr_focus.order(snap.get('baselayerAppIds', []), snap.get('focusableApps', []), app)
                if order is not None:
                    x = X(os.environ['DISPLAY'])
                    try:
                        x.cardinals(x.root, 'GAMESCOPECTRL_BASELAYER_APPID', order)
                    finally:
                        x.close()
            except (OSError, AgentError) as e:
                log("focus snapshot failed: %s" % e)
                time.sleep(2)
                continue
            if tag_game_windows(snap):
                self.changed.set()
                continue
            if FocusReassert.enabled():
                actions = self.reassert.plan(snap)
                if actions:
                    self.reassert.apply(actions)
                    if any(a[0] == "restore" for a in actions):
                        self.changed.set()
            if not FocusGuard.off():
                try:
                    actions = self.guard.plan(snap)
                    if actions:
                        self.guard.apply(actions, control_busy=self.reassert.control is not None)
                except Exception as e:  # never let the focus watcher die
                    log("focus guard: %s: %s" % (type(e).__name__, e))
            try:
                self.nudge_dialog(snap)
            except OSError as e:
                log("dialog nudge failed: %s" % e)
            body = {k: v for k, v in snap.items() if k != "t"}
            if body == self.last:
                continue
            self.last = body
            self.seq += 1
            snap["seq"] = self.seq
            write_json(self.path, snap)

    def listen(self):
        while True:
            try:
                x = X(os.environ["DISPLAY"])
                wanted = {x.atom(name) for name in FOCUS_PROPS}
                x.select(x.root, 0x400000)
                x.s.settimeout(None)
                self.changed.set()
                while True:
                    event = x.next_event()
                    if event[0] & 0x7F == 28 and struct.unpack_from("<I", event, 8)[0] in wanted:
                        self.changed.set()
            except OSError as e:
                log("focus events: %s; reconnecting" % e)
                time.sleep(2)


def read_padapply_state(path):
    """$FAKE_EVDEV_DIR/.padapply/state as written by libfakeinput in the Steam client."""
    try:
        text = path.read_text()
    except OSError:
        return None
    state = {}
    for item in text.split():
        key, _, value = item.partition("=")
        state[key] = int(value) if value.isdigit() else value
    return state if "adopts" in state else None


def padapply_identity(state):
    """Which adopt a state line belongs to. adopts counts from 1 in every Steam process, so
    a stale adopts=1 from an older Steam pid must not hide a new process's adopt #1
    (control-padapply2: the agent never saw it). pid/at are missing in pre-rev-3 lines."""
    return (state.get("pid"), state.get("adopts"), state.get("at"))


class PadApply(threading.Thread):
    """Makes Steam re-apply its controller config after it re-created its virtual pad.

    Steam re-creates the virtual X360 pad during some game loads; libfakeinput keeps the old
    node for the game (adopt), but Steam then writes nothing into it until its next
    controller-config apply, which a guide open/close does (Control, control-padguide3,
    2026-11-01). libfakeinput publishes adopts, events fed since the adopt and dead marks
    (Deck input held while nothing reaches the pad) in .padapply/state. Per adopt, with a
    game in focus, this runs the stages of BL_PADAPPLY_STAGES (default "ABC") in order:
      A  SteamClient.Input.ForceConfiguratorFocus(true), 0.4 s, (false): invisible; run on
         its own once the adopt settled (SETTLE, 3 s), before any input.
      B  GAMESCOPE_FOCUSED_APP to 769 (the Steam UI) for FLICK s and back, on Steam's X
         server: Steam sees a focus switch and back, gamescope's real focus never changes,
         nothing is shown.
      C  guide tap, then a second tap once the Steam menu has focus: the Steam menu shows
         for about half a second (the only visible stage).
    A later stage runs only after a new dead mark. Every step goes to pad.log as
    "agent: padapply: ...". BL_PADAPPLY=0 turns it off."""

    POLL = 0.1
    # A re-create at the game's exit is followed by Steam's switch to its UI 0.5-1.9 s later
    # (control.md "Pad-keep run analysis" (2)); waiting 3 s keeps stage A off those adopts
    # (control-padapply run 1: adopt 11:05:46.1, game gone, focus 769 at 11:05:47.9).
    SETTLE = 3.0
    FLICK = 0.4
    FOCUS_WAIT = 1.5

    def __init__(self, agent_dir, evdev_dir, log_file=None, stages="ABC", display=None):
        super().__init__(daemon=True, name="padapply")
        self.agent_dir = agent_dir
        self.dir = Path(evdev_dir) / ".padapply"
        self.log_file = log_file
        self.stages = [s for s in stages.upper() if s in "ABC"]
        self.display = display or os.environ.get("DISPLAY")
        self.last = None
        self.cycle = None

    def pad_log(self, message):
        log("padapply: " + message)
        if not self.log_file:
            return
        now = time.time()
        stamp = time.strftime("%H:%M:%S", time.localtime(now)) + ".%03d" % int(now % 1 * 1000)
        try:
            fd = os.open(self.log_file, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
            try:
                os.write(fd, ("%s %d agent: padapply: %s\n" % (stamp, os.getpid(), message)).encode())
            finally:
                os.close(fd)
        except OSError:
            pass

    def state(self):
        return read_padapply_state(self.dir / "state")

    def focused_app(self):
        x = X(self.display)
        try:
            value = x.prop(x.root, "GAMESCOPE_FOCUSED_APP")
            return value[0] if value else None
        finally:
            x.close()

    def focusable_apps(self):
        x = X(self.display)
        try:
            return x.prop(x.root, "GAMESCOPE_FOCUSABLE_APPS") or []
        finally:
            x.close()

    def game_in_focus(self):
        """The focused game, only while gamescope still lists it as focusable (a game that is
        exiting drops out of that list before the focus moves to Steam)."""
        try:
            app = self.focused_app()
            focusable = self.focusable_apps() if app and app != STEAM_UI_APP else []
        except OSError as e:
            return None, "no focus (%s)" % e
        if not app or app == STEAM_UI_APP:
            return None, "focus %s" % app
        if app not in focusable:
            return None, "focus %s not in the focusable apps %s" % (app, focusable)
        return app, None

    def stage_a(self, app):
        result = cdp_eval(self.agent_dir, """(async () => {
            const input = globalThis.SteamClient?.Input;
            if (typeof input?.ForceConfiguratorFocus !== 'function') return 'no SteamClient.Input.ForceConfiguratorFocus';
            input.ForceConfiguratorFocus(true);
            await new Promise(done => setTimeout(done, 400));
            input.ForceConfiguratorFocus(false);
            return 'ForceConfiguratorFocus true/false';
        })()""", timeout=5)
        return str(result.get("value"))

    def stage_b(self, app):
        x = X(self.display)
        try:
            before = x.prop(x.root, "GAMESCOPE_FOCUSED_APP")
            if not before or before[0] != app:
                return "skipped, focus is %s now" % (before[0] if before else None)
            FLICK_UNTIL[0] = time.monotonic() + self.FLICK + 1.0
            x.set_cardinals(x.root, "GAMESCOPE_FOCUSED_APP", [STEAM_UI_APP])
            time.sleep(self.FLICK)
            during = x.prop(x.root, "GAMESCOPE_FOCUSED_APP")
            if during == [STEAM_UI_APP]:
                x.set_cardinals(x.root, "GAMESCOPE_FOCUSED_APP", before)
                return "focus flick %d -> %d -> %d (%.1f s)" % (app, STEAM_UI_APP, app, self.FLICK)
            return "focus flick %d -> %d; gamescope set %s meanwhile, left as is" % (app, STEAM_UI_APP, during)
        finally:
            FLICK_UNTIL[0] = time.monotonic() + 0.3
            x.close()

    def request_guide(self):
        """One guide tap through libfakeinput; True once a Deck report thread took it."""
        st = self.state() or {}
        taps = st.get("guide", 0)
        request = self.dir / "guide"
        request.touch()
        deadline = time.monotonic() + 1.0
        while time.monotonic() < deadline:
            time.sleep(0.05)
            if (self.state() or {}).get("guide", 0) > taps:
                return True
        try:
            request.unlink()
        except OSError:
            pass
        return False

    def wait_focus(self, want):
        deadline = time.monotonic() + self.FOCUS_WAIT
        while time.monotonic() < deadline:
            try:
                if want(self.focused_app()):
                    return True
            except OSError:
                pass
            time.sleep(0.05)
        return False

    def stage_c(self, app):
        if not self.request_guide():
            return "guide tap 1 not taken (no Deck reader in the poll window)"
        if not self.wait_focus(lambda a: a == STEAM_UI_APP):
            return "guide tap 1 did not bring the Steam menu; no second tap"
        time.sleep(0.3)
        for tap in (2, 3):
            if not self.request_guide():
                return "guide tap %d not taken; the Steam menu may still be open" % tap
            if self.wait_focus(lambda a: a == app):
                return "guide taps 1+%d: Steam menu opened and closed, focus back on %d" % (tap - 1, app)
        return "guide taps: focus did not come back to %d; the Steam menu may still be open" % app

    def run_stage(self, why):
        cycle = self.cycle
        if cycle["next"] >= len(self.stages):
            if not cycle.get("exhausted"):
                cycle["exhausted"] = True
                self.pad_log("adopt #%d: %s, all stages (%s) used" % (cycle["adopt"], why, "".join(self.stages)))
            return
        app, reason = self.game_in_focus()
        if app is None:
            self.pad_log("adopt #%d: %s, not acting (%s)" % (cycle["adopt"], why, reason))
            return
        stage = self.stages[cycle["next"]]
        cycle["next"] += 1
        cycle["last"] = stage
        try:
            result = {"A": self.stage_a, "B": self.stage_b, "C": self.stage_c}[stage](app)
        except (AgentError, OSError) as e:
            result = "failed: %s" % e
        self.pad_log("adopt #%d: %s -> stage %s on app %d: %s" % (cycle["adopt"], why, stage, app, result))

    def step(self, now=None):
        now = time.monotonic() if now is None else now
        st = self.state()
        if st is None:
            if self.last is None:
                self.last = {"adopts": 0}  # no adopt in this session yet
            return
        last, self.last = self.last, st
        if last is None:
            # the agent (re)started: a state from before is old; only a new (pid, adopts, at) counts
            log("padapply: state from before the start ignored (Steam pid %s, adopt #%d)"
                % (st.get("pid", "?"), st["adopts"]))
            return
        if padapply_identity(st) != padapply_identity(last):
            self.cycle = {"adopt": st["adopts"], "t": now, "next": 0, "dead": 0, "last": None, "settled": False}
            pid = " (Steam pid %d)" % st["pid"] if isinstance(st.get("pid"), int) else ""
            self.pad_log("adopt #%d of %s seen%s" % (st["adopts"], st.get("node"), pid))
        cycle = self.cycle
        if not cycle or cycle.get("done"):
            return
        if st.get("fed", 0) > 0:
            cycle["done"] = True
            self.pad_log("adopt #%d: the pad is fed again (after %s)"
                         % (cycle["adopt"], "stage " + cycle["last"] if cycle["last"] else "no stage"))
            return
        if not cycle["settled"] and now - cycle["t"] >= self.SETTLE:
            cycle["settled"] = True
            if self.stages and self.stages[0] in "AB":
                self.run_stage("settled")
        dead = st.get("dead", 0)
        if dead > cycle["dead"]:
            cycle["dead"] = dead
            self.run_stage("dead mark %d" % dead)

    def run(self):
        self.pad_log("watching %s (stages %s)" % (self.dir, "".join(self.stages) or "none"))
        while True:
            try:
                self.step()
            except Exception as e:  # never let the watcher die
                log("padapply: %s: %s" % (type(e).__name__, e))
                time.sleep(1)
            time.sleep(self.POLL)



class WebSocket:

    def __init__(self, url, timeout):
        target = urllib.parse.urlsplit(url)
        if (target.scheme != "ws" or target.hostname not in ("127.0.0.1", "::1", "localhost")
                or target.username is not None or target.password is not None or target.fragment):
            raise AgentError("INVALID_TARGET", "DevTools targets must use a loopback WebSocket")
        hostport = target.netloc
        path = target.path or "/"
        if target.query:
            path += "?" + target.query
        host = "127.0.0.1" if target.hostname == "localhost" else target.hostname
        self.s = socket.create_connection((host, target.port or 80), timeout=timeout)
        try:
            self._handshake(path, hostport)
        except Exception:
            self.s.close()
            raise

    def _handshake(self, path, hostport):
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((
            "GET %s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
            "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n" % (path, hostport, key)
        ).encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.s.recv(4096)
            if not chunk:
                raise OSError("DevTools closed the connection during the handshake")
            head += chunk
            if len(head) > 16 * 1024:
                raise AgentError("RESPONSE_TOO_LARGE", "The DevTools handshake exceeds 16 KiB")
        status = head.split(b"\r\n", 1)[0]
        if b" 101 " not in status:
            raise OSError("DevTools refused the WebSocket: " + status.decode(errors="replace"))
        self.buffer = head.split(b"\r\n\r\n", 1)[1]

    def _read(self, n):
        while len(self.buffer) < n:
            chunk = self.s.recv(65536)
            if not chunk:
                raise OSError("DevTools closed the connection")
            self.buffer += chunk
        data, self.buffer = self.buffer[:n], self.buffer[n:]
        return data

    def send(self, text):
        payload = text.encode()
        header = bytearray([0x81])
        n = len(payload)
        if n < 126:
            header.append(0x80 | n)
        elif n < 65536:
            header.append(0x80 | 126)
            header += struct.pack(">H", n)
        else:
            header.append(0x80 | 127)
            header += struct.pack(">Q", n)
        mask = os.urandom(4)
        header += mask
        self.s.sendall(bytes(header) + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))

    def recv(self):
        message = b""
        while True:
            b0, b1 = self._read(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            if n > RESPONSE_CAP or len(message) + n > RESPONSE_CAP:
                raise AgentError("RESPONSE_TOO_LARGE", "The DevTools response exceeds 1 MiB")
            mask = self._read(4) if b1 & 0x80 else None
            data = self._read(n)
            if mask:
                data = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
            op = b0 & 0x0F
            if op == 8:
                raise OSError("DevTools closed the WebSocket")
            if op == 9:
                continue
            if op in (0, 1, 2):
                message += data
                if b0 & 0x80:
                    return message.decode(errors="replace")

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass


def cdp_port(agent_dir):
    try:
        port = (agent_dir / "cdp-port").read_text().strip()
    except OSError:
        port = os.environ.get("BL_CDP_PORT", "")
    if not port.isdigit():
        raise AgentError("NO_DEVTOOLS", "The Steam client's DevTools port is not known (no Steam client in this session yet)")
    return int(port)


def cdp_targets(agent_dir, timeout=5):
    url = "http://127.0.0.1:%d/json" % cdp_port(agent_dir)
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            data = r.read(RESPONSE_CAP + 1)
            if len(data) > RESPONSE_CAP:
                raise AgentError("RESPONSE_TOO_LARGE", "The DevTools response exceeds 1 MiB")
            return json.loads(data.decode())
    except OSError as e:
        raise AgentError("DEVTOOLS_UNREACHABLE", "Could not reach the client's DevTools at %s: %s" % (url, e))


def cdp_eval(agent_dir, expression, target=None, await_promise=True, timeout=15):
    targets = [t for t in cdp_targets(agent_dir) if t.get("webSocketDebuggerUrl")]
    want = target or "SharedJSContext"
    match = [t for t in targets if want in (t.get("title") or "") or want in (t.get("url") or "")]
    if not match:
        names = ", ".join(sorted({t.get("title") or t.get("url") or "?" for t in targets}))
        raise AgentError("NO_TARGET", "No DevTools target matches '%s' (have: %s)" % (want, names))
    ws = WebSocket(match[0]["webSocketDebuggerUrl"], timeout)
    try:
        ws.send(json.dumps({"id": 1, "method": "Runtime.evaluate", "params": {
            "expression": expression, "returnByValue": True, "awaitPromise": await_promise,
            "userGesture": True,
        }}))
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            message = json.loads(ws.recv())
            if message.get("id") != 1:
                continue
            if "error" in message:
                raise AgentError("CDP_ERROR", json.dumps(message["error"]))
            result = message.get("result", {})
            if result.get("exceptionDetails"):
                details = result["exceptionDetails"]
                text = (details.get("exception") or {}).get("description") or details.get("text") or "exception"
                raise AgentError("JS_EXCEPTION", text)
            value = result.get("result", {})
            return {"target": match[0].get("title"), "type": value.get("type"),
                    "value": value.get("value"), "description": value.get("description")}
        raise AgentError("TIMEOUT", "No answer from DevTools in %ss" % timeout)
    finally:
        ws.close()


KEYBOARD_BINDING = "droiddeckSteamKeyboard"
KEYBOARD_CHECK_SECONDS = 30
KEYBOARD_JS = r"""
(() => {
  const self = window.__droiddeckKeyboard || (window.__droiddeckKeyboard = { watched: new WeakSet(), last: null });
  self.wrapped = self.wrapped || new WeakSet();
  self.route = self.route === true;
  self.wrap = vkm => {
    if (!vkm || self.wrapped.has(vkm) || typeof vkm.ShowVirtualKeyboard !== "function") return;
    self.wrapped.add(vkm);
    const show = vkm.ShowVirtualKeyboard;
    vkm.ShowVirtualKeyboard = function (ref, props, modal) {
      if (self.route && !modal && typeof this.SetActiveVirtualKeyboardTarget === "function" &&
          !this.BUseVRKeyboard?.() && !this.m_Instance?.IsDesktopOverlayWindow?.()) {
        this.SetActiveVirtualKeyboardTarget(ref, props);
        self.follow(this);
        if (typeof window.__BINDING__ === "function") window.__BINDING__("request");
        return;
      }
      return show.call(this, ref, props, modal);
    };
  };
  self.editing = vkm => {
    let el = null;
    try { el = vkm?.m_ownerWindow?.document?.activeElement || null; } catch (e) {}
    if (!el) return null;
    return el.tagName === "TEXTAREA" || el.isContentEditable === true ||
      (el.tagName === "INPUT" && !/^(button|checkbox|radio|range|submit|reset|file|image|color)$/i.test(el.type || ""));
  };
  self.follow = vkm => {
    self.active = vkm;
    self.missed = 0;
    self.seen = false;
    self.follower = self.follower || setInterval(() => {
      if (!self.active) return;
      const ref = self.active.m_currentVirtualKeyboardRef;
      const editing = self.editing(self.active);
      const valid = !!ref && (editing !== null ? editing :
        (typeof ref.BIsElementValidForInput !== "function" || ref.BIsElementValidForInput()));
      if (valid) self.seen = true;
      if (self.route && ref && (valid || !self.seen)) {
        self.missed = 0;
        return;
      }
      if (++self.missed < 2) return;
      self.active = null;
      clearInterval(self.follower);
      self.follower = null;
      if (typeof window.__BINDING__ === "function") window.__BINDING__("dismiss");
    }, 150);
  };
  self.check = () => {
    let showing = false;
    for (const win of Array.from(globalThis.SteamUIStore?.WindowStore?.SteamUIWindows || [])) {
      self.wrap(win?.VirtualKeyboardManager);
      const value = win?.VirtualKeyboardManager?.IsShowingVirtualKeyboard;
      if (!value) continue;
      if (!self.watched.has(value) && typeof value.Subscribe === "function") {
        self.watched.add(value);
        value.Subscribe(() => setTimeout(() => self.check()));
      }
      if (value.m_currentValue === true) showing = true;
    }
    if (showing !== self.last) {
      self.last = showing;
      if (typeof window.__BINDING__ === "function") window.__BINDING__(String(showing));
    }
    return showing;
  };
  self.timer = self.timer || setInterval(() => self.check(), 500);
  return self.check();
})()
""".replace("__BINDING__", KEYBOARD_BINDING)
KEYBOARD_ROUTE_SECONDS = 0.5
KEYBOARD_ROUTE_JS = r"""
(route => {
  const self = window.__droiddeckKeyboard;
  if (!self) return false;
  self.route = route;
  if (!route) return true;
  for (const win of Array.from(globalThis.SteamUIStore?.WindowStore?.SteamUIWindows || [])) {
    const vkm = win?.VirtualKeyboardManager;
    if (vkm?.m_bIsInlineVirtualKeyboardOpen?.m_currentValue === true && vkm?.m_bIsVirtualKeyboardModal?.m_currentValue !== true &&
        typeof vkm.SetVirtualKeyboardHidden === "function") {
      const ref = vkm.m_currentVirtualKeyboardRef, props = vkm.m_ActiveElementProps;
      vkm.SetVirtualKeyboardHidden();
      if (ref && typeof vkm.SetActiveVirtualKeyboardTarget === "function") {
        vkm.SetActiveVirtualKeyboardTarget(ref, props);
        if (typeof self.follow === "function") self.follow(vkm);
      }
      if (typeof window.__BINDING__ === "function") window.__BINDING__("request");
    }
  }
  return true;
})(__ROUTE__)
""".replace("__BINDING__", KEYBOARD_BINDING)


class KeyboardWatcher(threading.Thread):
    def __init__(self, agent_dir):
        super().__init__(daemon=True, name="keyboard")
        self.agent_dir = agent_dir
        self.path = agent_dir / "keyboard.json"
        self.request_path = agent_dir / "keyboard-request.json"
        self.dismiss_path = agent_dir / "keyboard-dismiss.json"
        self.dismissals = 0
        self.route_path = agent_dir / "keyboard-route"
        self.showing = None
        self.seq = 0
        self.requests = 0
        self.route = None
        self.next_id = 0
        self.attached = False

    def report(self, showing):
        if showing == self.showing:
            return
        self.showing = showing
        self.seq += 1
        write_json(self.path, {"steamKeyboard": showing, "seq": self.seq})

    def request(self):
        self.requests += 1
        write_json(self.request_path, {"seq": self.requests})

    def dismiss(self):
        self.dismissals += 1
        write_json(self.dismiss_path, {"seq": self.dismissals})

    def wanted_route(self):
        try:
            return self.route_path.read_text().strip() == "bottom"
        except OSError:
            return False

    def apply_route(self, ws, force=False):
        route = self.wanted_route()
        if route == self.route and not force:
            return
        result = self.call(ws, "Runtime.evaluate", {
            "expression": KEYBOARD_ROUTE_JS.replace("__ROUTE__", "true" if route else "false"), "returnByValue": True})
        if result.get("exceptionDetails"):
            raise AgentError("JS_EXCEPTION", json.dumps(result["exceptionDetails"])[:500])
        self.route = route

    def run(self):
        failures, last = 0, None
        while True:
            try:
                self.watch()
            except Exception as e:
                note_webhelper_trouble(e)
                if self.attached:
                    log("Steam keyboard: lost the client (%s); reattaching" % e)
                    failures = 0
                elif str(e) != last:
                    log("Steam keyboard: waiting for the client (%s)" % e)
                self.attached = False
                last = str(e)
            self.report(False)
            failures += 1
            time.sleep(min(2 * failures, 10))

    def watch(self):
        targets = [t for t in cdp_targets(self.agent_dir)
                   if t.get("title") == "SharedJSContext" and t.get("webSocketDebuggerUrl")]
        if not targets:
            raise AgentError("NO_TARGET", "No SharedJSContext yet")
        ws = WebSocket(targets[0]["webSocketDebuggerUrl"], 5)
        try:
            self.call(ws, "Runtime.addBinding", {"name": KEYBOARD_BINDING})
            self.report(self.install(ws))
            self.apply_route(ws, force=True)
            self.attached = True
            installed = time.monotonic()
            while True:
                wait = min(KEYBOARD_ROUTE_SECONDS, KEYBOARD_CHECK_SECONDS)
                if not ws.buffer and not select.select([ws.s], [], [], wait)[0]:
                    if time.monotonic() - installed >= KEYBOARD_CHECK_SECONDS:
                        self.report(self.install(ws))
                        self.apply_route(ws, force=True)
                        installed = time.monotonic()
                    else:
                        self.apply_route(ws)
                    continue
                self.event(json.loads(ws.recv()))
        finally:
            ws.close()

    def install(self, ws):
        result = self.call(ws, "Runtime.evaluate", {"expression": KEYBOARD_JS, "returnByValue": True})
        if result.get("exceptionDetails"):
            raise AgentError("JS_EXCEPTION", json.dumps(result["exceptionDetails"])[:500])
        return result.get("result", {}).get("value") is True

    def call(self, ws, method, params):
        self.next_id += 1
        ws.send(json.dumps({"id": self.next_id, "method": method, "params": params}))
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            message = json.loads(ws.recv())
            if message.get("id") == self.next_id:
                if "error" in message:
                    raise AgentError("CDP_ERROR", json.dumps(message["error"]))
                return message.get("result", {})
            self.event(message)
        raise AgentError("TIMEOUT", "No answer to %s from DevTools" % method)

    def event(self, message):
        params = message.get("params") or {}
        if message.get("method") == "Runtime.bindingCalled" and params.get("name") == KEYBOARD_BINDING:
            if params.get("payload") == "request":
                self.request()
            elif params.get("payload") == "dismiss":
                self.dismiss()
            else:
                self.report(params.get("payload") == "true")


def steam_idle_inhibit(agent_dir, inhibit):
    expression = """(async want => {
        const toggle = () => new Promise(done => {
            let handle = null;
            let timer = null;
            const finish = value => {
                clearTimeout(timer);
                handle?.unregister?.();
                done(value);
            };
            timer = setTimeout(() => finish(null), 2500);
            handle = SteamClient.Console.RegisterForSpewOutput(entry => {
                const found = /Suspend inhibit: ([01])/.exec(entry?.spew || "");
                if (found) finish(found[1] === "1");
            });
            SteamClient.Console.ExecCommand("toggle_idle_suspend_inhibit 1");
        });
        let state = await toggle();
        if (state === !want) state = await toggle();
        return state === want;
    })(%s)""" % ("true" if inhibit else "false")
    return cdp_eval(agent_dir, expression, timeout=12).get("value") is True


def steam_idle_suspend_seconds(agent_dir, vpower=Path("/run/vpower/ac_status")):
    expression = """(() => {
        const settings = globalThis.settingsStore?.clientSettings;
        return settings ? [settings.system_idle_suspend_ac_sec, settings.system_idle_suspend_battery_sec] : null;
    })()"""
    seconds = cdp_eval(agent_dir, expression, await_promise=False, timeout=5).get("value")
    if not isinstance(seconds, list) or len(seconds) != 2:
        return None
    try:
        on_ac = vpower.read_text().strip() != "Disconnected"
    except OSError:
        on_ac = True
    value = seconds[0 if on_ac else 1]
    return max(0, int(value)) if isinstance(value, (int, float)) else None


def steam_selection(agent_dir, timeout=5):
    result = cdp_eval(
        agent_dir,
        """(() => {
            let node = document.activeElement;
            while (node) {
                for (const name of ["data-id", "data-appid"]) {
                    const value = node.getAttribute?.(name);
                    if (/^[1-9][0-9]{0,9}$/.test(value || "")) {
                        const appId = Number(value);
                        if (Number.isSafeInteger(appId) && appId <= 4294967295) return value;
                    }
                }
                node = node.parentElement;
            }
            return null;
        })()""",
        target="Steam Big Picture Mode",
        timeout=timeout,
    )
    value = result.get("value")
    if value is None:
        return {"appId": None}
    if not isinstance(value, str) or not value.isdigit() or not 0 < int(value) <= 4294967295:
        raise AgentError("INVALID_SELECTION", "Steam returned an invalid selected app id")
    return {"appId": int(value)}


def steam_shortcut_app_id(game_id):
    if not isinstance(game_id, str) or not game_id.isascii() or not game_id.isdigit():
        return None
    try:
        game_id_value = int(game_id)
    except ValueError:
        return None
    if str(game_id_value) != game_id or not 0 < game_id_value <= 0xFFFFFFFFFFFFFFFF:
        return None
    if game_id_value <= 0xFFFFFFFF or game_id_value & 0xFFFFFFFF != 0x02000000:
        return None
    app_id = game_id_value >> 32
    return app_id if 0 < app_id <= 0xFFFFFFFF else None


def wait_for_steam_shortcut_overview(agent_dir, game_id, timeout=45):
    app_id = steam_shortcut_app_id(game_id)
    if app_id is None:
        return {"supported": False, "ready": False}

    timeout = request_timeout({"timeout": timeout}, 45)
    deadline = time.monotonic() + timeout
    expression = """(() => {
        const store = globalThis.appStore;
        if (typeof store?.GetAppOverviewByGameID !== 'function') return null;
        const overview = store.GetAppOverviewByGameID(%s);
        return overview == null ? null : String(overview.appid);
    })()""" % json.dumps(game_id)
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        try:
            result = cdp_eval(agent_dir, expression, await_promise=False,
                              timeout=min(5, max(0.25, remaining)))
            if result.get("value") == str(app_id):
                return {"supported": True, "ready": True, "appId": app_id}
        except AgentError as error:
            if error.code not in ("NO_DEVTOOLS", "DEVTOOLS_UNREACHABLE", "NO_TARGET", "TIMEOUT"):
                raise
        time.sleep(min(0.25, max(0, deadline - time.monotonic())))
    raise AgentError("STEAM_OVERVIEW_TIMEOUT", "Steam did not load shortcut app overview %d" % app_id)


def steam_shortcut_state(agent_dir, game_id, timeout=6):
    if steam_shortcut_app_id(game_id) is None:
        return "not-shortcut"
    timeout = request_timeout({"timeout": timeout}, 6)
    deadline = time.monotonic() + timeout
    expression = """(() => {
        const store = globalThis.appStore;
        if (typeof store?.GetAppOverviewByGameID !== 'function' || !store.m_bIsInitialized) return 'loading';
        if (store.GetAppOverviewByGameID(%s) != null) return 'ready';
        return store.allApps.some(app => app.app_type == 1073741824) ? 'missing' : 'loading';
    })()""" % json.dumps(game_id)
    state = "loading"
    while True:
        try:
            state = cdp_eval(agent_dir, expression, await_promise=False,
                             timeout=min(5, max(0.25, deadline - time.monotonic()))).get("value") or "loading"
        except AgentError as error:
            if error.code not in ("NO_DEVTOOLS", "DEVTOOLS_UNREACHABLE", "NO_TARGET", "TIMEOUT"):
                raise
            state = "loading"
        if state == "ready" or time.monotonic() >= deadline:
            return state
        time.sleep(min(0.5, max(0, deadline - time.monotonic())))
def run_steam_shortcut(agent_dir, game_id, timeout=45):
    """Start a shortcut the way the client's Play button does (SteamClient.Apps.RunGame).

    A shortcut started from a steam://rungameid URL runs, but its window never got the
    STEAM_GAME tag on the games' Xwayland, so gamescope left it out of the focusable list
    and the game stayed behind the client (The Long Dark, 2026-10-30 T2 run 1). Started
    from the tile it was tagged and focused (T2 run 2). Non-shortcut ids return
    supported=False and keep the URL path."""
    prepared = wait_for_steam_shortcut_overview(agent_dir, game_id, timeout)
    if not prepared["supported"]:
        return prepared
    expression = """(() => {
        if (typeof SteamClient?.Apps?.RunGame !== 'function') throw new Error('no SteamClient.Apps.RunGame');
        SteamClient.Apps.RunGame(%s, "", -1, 100);
        return "started";
    })()""" % json.dumps(game_id)
    result = cdp_eval(agent_dir, expression, await_promise=False, timeout=10)
    if result.get("value") != "started":
        raise AgentError("RUN_GAME_FAILED", "RunGame returned %r" % (result.get("value"),))
    return {"supported": True, "started": True, "appId": prepared["appId"]}


def game_pids(app_id):
    wanted = [("SteamAppId=%s" % app_id).encode(), ("SteamGameId=%s" % app_id).encode()]
    me = os.getpid()
    pids = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) == me:
            continue
        try:
            with open("/proc/%s/environ" % entry, "rb") as f:
                env = f.read().split(b"\0")
        except OSError:
            continue
        if any(w in env for w in wanted):
            pids.append(int(entry))
    return pids


def quit_game(agent_dir, app_id, timeout):
    if not str(app_id).isdigit():
        raise AgentError("INVALID_APP_ID", "appId must be a decimal Steam app id")
    steps = []
    if game_pids(app_id):
        try:
            cdp_eval(agent_dir, "SteamClient.Apps.TerminateApp(%s, false)" % json.dumps(str(app_id)), timeout=5)
            steps.append("client")
        except AgentError as e:
            steps.append("client unavailable: %s" % e)
    deadline = time.monotonic() + timeout
    while game_pids(app_id) and time.monotonic() < deadline:
        time.sleep(0.5)
    left = game_pids(app_id)
    if left:
        steps.append("SIGTERM %s" % left)
        for pid in left:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        end = time.monotonic() + 5
        while game_pids(app_id) and time.monotonic() < end:
            time.sleep(0.5)
        left = game_pids(app_id)
        if left:
            steps.append("SIGKILL %s" % left)
            for pid in left:
                try:
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    pass
            time.sleep(1)
    return {"appId": int(app_id), "steps": steps, "remaining": game_pids(app_id)}



VR_HELPER = "/usr/local/bin/droiddeck-steamvr"
VR_ACTIONS = ("status", "install", "start", "stop")


def steamvr(req):
    action = req.get("action", "status")
    if action not in VR_ACTIONS:
        raise AgentError("INVALID_REQUEST", "vr action must be one of " + ", ".join(VR_ACTIONS))
    helper = os.environ.get("DROIDDECK_VR_HELPER", VR_HELPER)
    if not os.path.isfile(helper):
        raise AgentError("UNAVAILABLE", "this runtime has no " + helper)
    if action == "install":
        state = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "droiddeck-steamvr"
        state.mkdir(parents=True, exist_ok=True)
        with open(state / "install.log", "ab") as log_file:
            subprocess.Popen(["sh", helper, "install"], stdin=subprocess.DEVNULL, stdout=log_file,
                             stderr=subprocess.STDOUT, start_new_session=True)
        return {"action": action, "started": True}
    done = subprocess.run(["sh", helper, action], stdin=subprocess.DEVNULL, capture_output=True,
                          timeout=request_timeout(req, 30))
    out = done.stdout.decode("utf-8", "replace").strip()
    result = {"action": action, "exitCode": done.returncode, "output": out[-2000:]}
    if action == "status":
        for part in out.split():
            key, _, value = part.partition("=")
            if key in ("installed", "running", "installing", "driver"):
                result[key] = value == "1"
    return result


def run_exec(req):
    argv = req.get("argv")
    if not isinstance(argv, list) or not argv or not all(isinstance(a, str) and "\0" not in a for a in argv):
        raise AgentError("INVALID_REQUEST", "exec needs argv, a non-empty list of strings")
    timeout = request_timeout(req, 30)
    env = dict(os.environ)
    extra_env = req.get("env") if req.get("env") is not None else {}
    if not isinstance(extra_env, dict) or any("\0" in str(k) or "=" in str(k) or "\0" in str(v) for k, v in extra_env.items()):
        raise AgentError("INVALID_REQUEST", "env must be an object with valid environment entries")
    env.update({str(k): str(v) for k, v in extra_env.items()})
    stdin = req.get("stdin")
    if stdin is not None and not isinstance(stdin, str):
        raise AgentError("INVALID_REQUEST", "stdin must be a string")
    started = time.monotonic()
    try:
        proc = subprocess.Popen(
            argv, cwd=req.get("cwd") or None, env=env, start_new_session=True,
            stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
    except OSError as e:
        raise AgentError("EXEC_FAILED", "%s: %s" % (argv[0], e))
    captured = {"stdout": bytearray(), "stderr": bytearray()}
    truncated = {"stdout": False, "stderr": False}
    pending = memoryview(stdin.encode()) if stdin is not None else memoryview(b"")
    deadline = started + timeout
    timed_out = False
    try:
        with selectors.DefaultSelector() as selector:
            for stream, name in ((proc.stdout, "stdout"), (proc.stderr, "stderr")):
                os.set_blocking(stream.fileno(), False)
                selector.register(stream, selectors.EVENT_READ, name)
            if proc.stdin is not None:
                os.set_blocking(proc.stdin.fileno(), False)
                if pending:
                    selector.register(proc.stdin, selectors.EVENT_WRITE, "stdin")
                else:
                    proc.stdin.close()
            while selector.get_map() or proc.poll() is None:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    timed_out = True
                    break
                for key, _ in selector.select(min(0.1, remaining)):
                    stream, name = key.fileobj, key.data
                    if name == "stdin":
                        try:
                            pending = pending[os.write(stream.fileno(), pending[:65536]):]
                        except BrokenPipeError:
                            pending = pending[len(pending):]
                        if not pending:
                            selector.unregister(stream)
                            stream.close()
                    else:
                        data = os.read(stream.fileno(), 65536)
                        if not data:
                            selector.unregister(stream)
                            stream.close()
                            continue
                        available = OUTPUT_CAP - len(captured[name])
                        captured[name].extend(data[:available])
                        truncated[name] |= len(data) > available
        if timed_out:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        proc.wait(timeout=5)
    finally:
        if proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            proc.wait(timeout=5)
        for stream in (proc.stdin, proc.stdout, proc.stderr):
            if stream is not None:
                stream.close()

    def text(name):
        return {"text": captured[name].decode(errors="replace"), "truncated": truncated[name]}

    return {"exitCode": proc.returncode, "timedOut": timed_out,
            "seconds": round(time.monotonic() - started, 3), "stdout": text("stdout"), "stderr": text("stderr")}


def request_timeout(req, default):
    try:
        timeout = float(req.get("timeout", default))
    except (TypeError, ValueError):
        raise AgentError("INVALID_REQUEST", "timeout must be a positive number no greater than 600 seconds")
    if not math.isfinite(timeout) or not 0 < timeout <= 600:
        raise AgentError("INVALID_REQUEST", "timeout must be a positive number no greater than 600 seconds")
    return timeout


def handle(agent_dir, req):
    kind = req.get("kind")
    if kind == "ping":
        return {"pid": os.getpid(), "version": VERSION, "displays": displays()}
    if kind == "exec":
        return run_exec(req)
    if kind == "focus":
        return focus_snapshot()
    if kind == "cdp":
        if req.get("op") == "targets":
            return {"targets": [{k: t.get(k) for k in ("title", "url", "type")} for t in cdp_targets(agent_dir)]}
        expression = req.get("expression")
        if not isinstance(expression, str) or not expression:
            raise AgentError("INVALID_REQUEST", "cdp eval needs an expression")
        return cdp_eval(agent_dir, expression, req.get("target"), bool(req.get("awaitPromise", True)),
                        request_timeout(req, 15))
    if kind == "steam-selection":
        return steam_selection(agent_dir, request_timeout(req, 5))
    if kind == "quit":
        return quit_game(agent_dir, req.get("appId"), request_timeout(req, 15))
    if kind == "vr":
        return steamvr(req)
    raise AgentError("UNKNOWN_REQUEST", "Unknown agent request '%s'" % kind)


def answer(agent_dir, path):
    rid = path.stem
    try:
        with path.open("rb") as stream:
            data = stream.read(REQUEST_CAP + 1)
        if len(data) > REQUEST_CAP:
            raise ValueError("The request exceeds 256 KiB")
        req = json.loads(data)
        if not isinstance(req, dict):
            raise ValueError("The request must be a JSON object")
    except (OSError, ValueError) as e:
        req = None
        result = {"ok": False, "error": {"code": "INVALID_REQUEST", "message": str(e)}}
    finally:
        try:
            path.unlink()
        except OSError:
            pass
    if req is not None:
        try:
            result = dict(handle(agent_dir, req), ok=True)
        except AgentError as e:
            result = {"ok": False, "error": {"code": e.code, "message": str(e)}}
        except Exception as e:
            result = {"ok": False, "error": {"code": "AGENT_FAILED", "message": "%s: %s" % (type(e).__name__, e)}}
    write_json(agent_dir / "resp" / (rid + ".json"), result)


def serve(agent_dir, focus=True, poll=0.1):
    (agent_dir / "req").mkdir(parents=True, exist_ok=True)
    (agent_dir / "resp").mkdir(parents=True, exist_ok=True)
    can_focus = focus and bool(os.environ.get("DISPLAY"))
    if can_focus:
        FocusWatcher(agent_dir / "focus.json").start()
        evdev = os.environ.get("FAKE_EVDEV_DIR")
        if evdev and os.environ.get("FAKE_EVDEV_DECK", "0") != "0" and os.environ.get("BL_PADAPPLY", "1") != "0":
            PadApply(agent_dir, evdev, os.environ.get("FAKE_EVDEV_LOG_FILE"),
                     os.environ.get("BL_PADAPPLY_STAGES", "ABC")).start()
    if focus:
        KeyboardWatcher(agent_dir).start()
    write_json(agent_dir / "hello.json", {"pid": os.getpid(), "version": VERSION, "started": int(time.time() * 1000),
                                          "displays": displays(), "focus": can_focus})
    log("serving %s (focus %s)" % (agent_dir, "on" if can_focus else "off"))
    taken = set()
    while True:
        for path in sorted((agent_dir / "req").glob("*.json")):
            if path.name in taken:
                continue
            taken.add(path.name)
            threading.Thread(target=lambda p=path: (answer(agent_dir, p), taken.discard(p.name)),
                             daemon=True, name="req").start()
        time.sleep(poll)


def main(argv):
    base = os.environ.get("BL_LAUNCH_DIR")
    if not base:
        print("BL_LAUNCH_DIR is not set", file=sys.stderr)
        return 2
    if argv and argv[0] == "--wait-steam-shortcut-overview":
        if len(argv) not in (2, 3):
            print("usage: droiddeck-agent --wait-steam-shortcut-overview <cgameid> [timeout-seconds]", file=sys.stderr)
            return 2
        timeout = argv[2] if len(argv) == 3 else 45
        try:
            prepared = wait_for_steam_shortcut_overview(Path(base) / "agent", argv[1], timeout)
        except (AgentError, OSError, ValueError) as error:
            print("droiddeck-agent: shortcut overview was not ready: %s" % error, file=sys.stderr)
            return 1
        if not prepared["supported"]:
            print("droiddeck-agent: id is not a DroidDeck shortcut CGameID")
            return 3
        print("droiddeck-agent: Steam overview is ready for shortcut app %d" % prepared["appId"])
        return 0
    if argv and argv[0] == "--steam-supports-vr":
        if len(argv) != 2 or not argv[1].isascii() or not argv[1].isdecimal():
            print("usage: droiddeck-agent --steam-supports-vr <appid>", file=sys.stderr)
            return 2
        expression = ("(o => o ? (o.vr_supported === true || o.vr_only === true) : null)"
                      "(window.appStore?.GetAppOverviewByGameID?.(%s))" % json.dumps(argv[1]))
        value = None
        deadline = time.monotonic() + 12
        while value is None and time.monotonic() < deadline:
            try:
                value = cdp_eval(Path(base) / "agent", expression, await_promise=False, timeout=8).get("value")
            except (AgentError, OSError, ValueError):
                pass
            if value is None:
                time.sleep(0.5)
        print({True: "yes", False: "no"}.get(value, "unknown"))
        return {True: 0, False: 5}.get(value, 1)
    if argv and argv[0] == "--steam-asleep":
        expression = """(() => {
            const store = globalThis.SuspendResumeStore;
            return store ? (store.m_bSuspending ? 'yes' : 'no') : 'unknown';
        })()"""
        try:
            state = cdp_eval(Path(base) / "agent", expression, await_promise=False, timeout=3).get("value") or "unknown"
        except (AgentError, OSError, ValueError):
            state = "unknown"
        print(state)
        return {"yes": 0, "no": 5}.get(state, 1)
    if argv and argv[0] == "--steam-idle-inhibit":
        if len(argv) != 2 or argv[1] not in ("on", "off"):
            print("usage: droiddeck-agent --steam-idle-inhibit on|off", file=sys.stderr)
            return 2
        try:
            done = steam_idle_inhibit(Path(base) / "agent", argv[1] == "on")
        except (AgentError, OSError, ValueError) as error:
            print("droiddeck-agent: could not reach the client's idle sleep: %s" % error, file=sys.stderr)
            return 1
        return 0 if done else 1
    if argv and argv[0] == "--steam-idle-suspend-seconds":
        try:
            seconds = steam_idle_suspend_seconds(Path(base) / "agent")
        except (AgentError, OSError, ValueError) as error:
            print("droiddeck-agent: could not read the client's idle sleep: %s" % error, file=sys.stderr)
            return 1
        if seconds is None:
            return 1
        print(seconds)
        return 0
    if argv and argv[0] == "--steam-shortcut-state":
        if len(argv) not in (2, 3):
            print("usage: droiddeck-agent --steam-shortcut-state <cgameid> [timeout-seconds]", file=sys.stderr)
            return 2
        try:
            state = steam_shortcut_state(Path(base) / "agent", argv[1], argv[2] if len(argv) == 3 else 6)
        except (AgentError, OSError, ValueError) as error:
            print("droiddeck-agent: could not ask the client about the shortcut: %s" % error, file=sys.stderr)
            return 1
        print(state)
        return {"ready": 0, "missing": 4, "not-shortcut": 3}.get(state, 1)
    if argv and argv[0] == "--run-steam-shortcut":
        # Exit 0 started, 3 not a shortcut CGameID, 4 RunGame sent but unanswered (do not
        # launch again), 1 not started (the caller falls back to the URL).
        if len(argv) not in (2, 3):
            print("usage: droiddeck-agent --run-steam-shortcut <cgameid> [timeout-seconds]", file=sys.stderr)
            return 2
        timeout = argv[2] if len(argv) == 3 else 45
        try:
            started = run_steam_shortcut(Path(base) / "agent", argv[1], timeout)
        except AgentError as error:
            print("droiddeck-agent: RunGame for the shortcut: %s" % error, file=sys.stderr)
            return 4 if error.code == "TIMEOUT" else 1
        except (OSError, ValueError) as error:
            print("droiddeck-agent: RunGame for the shortcut: %s" % error, file=sys.stderr)
            return 1
        if not started["supported"]:
            print("droiddeck-agent: id is not a DroidDeck shortcut CGameID")
            return 3
        print("droiddeck-agent: started shortcut app %d through RunGame" % started["appId"])
        return 0
    serve(Path(base) / "agent", focus="--no-focus" not in argv)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
