GAME_TU_DEBUG = "DROIDDECK_GAME_TU_DEBUG"
SYNC_KEYS = ("BL_SYNC", "BL_SYNC_FALLBACK", "BL_FSYNC_FIRST", "BL_SYNC_MIN_NOFILE", "PROTON_NO_ESYNC", "PROTON_NO_FSYNC", "PROTON_NO_NTSYNC", "WINEESYNC")
SEED_REDISTS = "/usr/local/bin/droiddeck-seed-redists"
PACK_KEYS = ("WINESERVER", "BL_SYNC_PACK", "WINEESYNC", "PROTON_NO_ESYNC", "PROTON_NO_FSYNC")


def game_id(env):
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if not prefix:
        return None
    value = prefix.rsplit("/", 1)[-1]
    if not re.fullmatch(r"-?[0-9]+", value):
        return None
    number = int(value)
    if not -(2**31) <= number < 2**32 or number == 0:
        return None
    return str(number % 2**32)


DOTNET_FEX = {
    "FEX_TSOENABLED": "1",
    "FEX_VECTORTSOENABLED": "1",
    "FEX_MEMCPYSETTSOENABLED": "1",
    "FEX_HALFBARRIERTSOENABLED": "1",
    "FEX_X87REDUCEDPRECISION": "0",
}


def game_files(exe):
    names = set()
    folder = os.path.dirname(exe)
    try:
        with os.scandir(folder) as top:
            for entry in top:
                names.add(entry.name.lower())
                if entry.is_dir(follow_symlinks=False):
                    try:
                        with os.scandir(entry.path) as inner:
                            names.update(e.name.lower() for e in inner)
                    except OSError:
                        pass
    except OSError:
        pass
    return names


class Game:

    def __init__(self, exe, args):
        self.exe = exe
        self.args = args
        self.stem = os.path.splitext(os.path.basename(exe))[0].lower()
        self.files = game_files(exe)

    def has_arg(self, name):
        return any(a == name or a.startswith(name + "=") for a in self.args)


FIXES = []


def fix(function):
    FIXES.append(function)
    return function


def is_godot(game):
    return game.stem + ".pck" in game.files or "godotsharp.dll" in game.files


@fix
def dotnet_memory_ordering(game):
    if "coreclr.dll" in game.files:
        return DOTNET_FEX, [], ".NET runtime: FEX with full TSO"


@fix
def unity_memory_ordering(game):
    if {"unityplayer.so", "gameassembly.so", "unityplayer.dll"} & game.files:
        return {"FEX_TSOENABLED": "1"}, [], "Unity: FEX with TSO"


@fix
def godot_vulkan(game):
    if is_godot(game) and not game.has_arg("--rendering-driver"):
        return {}, ["--rendering-driver", "vulkan"], "Godot: Vulkan renderer"


@fix
def godot_sentry(game):
    sentry = sorted(n[:-4] for n in game.files if n.startswith("libsentry.windows.") and n.endswith(".dll"))
    if is_godot(game) and sentry and ("coreclr.dll" in game.files or "godotsharp.dll" in game.files):
        return {"WINEDLLOVERRIDES": ";".join(n + "=d" for n in sentry)}, [], "Godot: Sentry crash handler off"


@fix
def d3dgear_hook(game):
    if "d3dgear64.dll" in game.files:
        return {"WINEDLLOVERRIDES": "d3dgear64=d"}, [], "D3DGear capture hook off (it stops the game drawing)"


@fix
def deep_rock_gdk_raytracing(game):
    if game.stem == "fsd-wingdk-shipping" and not any(game.has_arg(arg) for arg in ("-raytracing", "-noraytracing")):
        return {}, ["-noraytracing", "-ini:Engine:[/Script/Engine.RendererSettings]:r.RayTracing=False"], "Deep Rock Galactic GDK: ray tracing off (D3D12 pipeline creation fails on Thor)"


@fix
def arkham_city_x87(game):
    if "batmanac.exe" in game.files:
        return {"FEX_X87REDUCEDPRECISION": "0"}, [], "Batman: Arkham City: FEX with full x87 precision"



@fix
def doom_2016_swapchain_images(game):
    if "doomx64vk.exe" in game.files and game.stem in ("doomx64", "doomx64vk"):
        images = {
            "GAMESCOPE_WSI_MIN_IMAGE_COUNT": None,
            "GAMESCOPE_WSI_ENSURE_MIN_IMAGE_COUNT": None,
            "vk_x11_strict_image_count": "true",
        }
        return images, [], "DOOM (2016): the swapchain keeps the image count the game asks for"


@fix
def teardown_vsync(game):
    if game.stem == "teardown":
        return {"vblank_mode": "2"}, [], "Teardown: OpenGL keeps the game's own vsync"


@fix
def protonfixes_off(game):
    if game.stem in ("blackops3", "darksoulsremastered"):
        return {"PROTONFIXES_DISABLE": "1"}, [], "umu-protonfixes off (its ALSA audio and VC++ installer steps fail here)"


@fix
def little_nightmares_threads(game):
    if game.stem == "littlenightmares":
        return {"PROTONFIXES_DISABLE": "1"}, [], "Little Nightmares: umu-protonfixes off (its -onethread puts the game and renderer on one thread)"


@fix
def caravan_sandwitch_feature_level(game):
    if "caravansandwitch.exe" in game.files or game.stem == "caravansandwitch-win64-shipping":
        return {"VKD3D_FEATURE_LEVEL": "12_1"}, [], "Caravan SandWitch: D3D12 feature level 12_1 (12_2 hands it mesh shader pipelines vkd3d-proton cannot build)"


@fix
def robocop_rogue_city_feature_level(game):
    if "robocop.exe" in game.files or game.stem == "robocop-win64-shipping":
        return {"VKD3D_FEATURE_LEVEL": "12_1"}, [], "RoboCop: Rogue City: D3D12 feature level 12_1"


@fix
def reskate_feature_level(game):
    if "skate.exe" in game.files and "reskate.dll" in game.files:
        return {"VKD3D_FEATURE_LEVEL": "12_1"}, [], "ReSkate (skate.): D3D12 feature level 12_1"


@fix
def cyberpunk_feature_level(game):
    if game.stem == "cyberpunk2077" or (
        game.stem == "redprelauncher"
        and os.path.isfile(os.path.join(os.path.dirname(game.exe), "bin", "x64", "Cyberpunk2077.exe"))
    ):
        return {"VKD3D_FEATURE_LEVEL": "12_1"}, [], "Cyberpunk 2077: D3D12 feature level 12_1"

def skip_red_launcher(command):
    if len(command) > 2 and os.path.basename(command[2]).lower() == "redprelauncher.exe":
        for exe, folder in (("Cyberpunk2077.exe", "x64"), ("witcher3.exe", "x64"), ("witcher3.exe", "x64_dx12")):
            game = os.path.join(os.path.dirname(command[2]), "bin", folder, exe)
            if os.path.isfile(game):
                if exe == "witcher3.exe":
                    try:
                        os.chdir(os.path.dirname(game))
                    except OSError:
                        pass
                print("droiddeck-game-env: REDlauncher skipped (%s)" % exe, file=sys.stderr)
                return command[:2] + [game] + command[3:]
    return command


UBISOFT_LAUNCHER = "drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher"
UBISOFT_SETTINGS = "drive_c/users/steamuser/AppData/Local/Ubisoft Game Launcher/settings.yaml"


def overlay_off(text):
    lines = text.splitlines()
    try:
        start = next(i for i, line in enumerate(lines) if re.fullmatch(r"overlay:\s*(#.*)?", line))
    except StopIteration:
        if lines and not lines[-1].strip():
            lines.pop()
        return "\n".join(lines + ["overlay:", "  enabled: false", "  warning_enabled: false"]) + "\n"
    end = start + 1
    for index in range(start + 1, len(lines)):
        if lines[index].strip() and not lines[index].startswith("  "):
            break
        if lines[index].strip():
            end = index + 1
    block = lines[start + 1:end]
    for key in ("enabled", "warning_enabled"):
        entry = "  %s: false" % key
        found = [i for i, line in enumerate(block) if line.split(":", 1)[0] == "  " + key]
        if found:
            block[found[0]] = entry
        else:
            block.append(entry)
    return "\n".join(lines[:start + 1] + block + lines[end:]) + "\n"


def ubisoft_overlay_off(env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    if not (prefix / UBISOFT_LAUNCHER).is_dir():
        return
    settings = prefix / UBISOFT_SETTINGS
    try:
        text = settings.read_text(encoding="utf-8") if settings.exists() else ""
        updated = overlay_off(text)
        if updated == text:
            return
        settings.parent.mkdir(parents=True, exist_ok=True)
        handle, staged = tempfile.mkstemp(prefix=".settings-", dir=settings.parent)
        try:
            with os.fdopen(handle, "w", encoding="utf-8") as target:
                target.write(updated)
            if settings.exists():
                os.chmod(staged, settings.stat().st_mode & 0o7777)
            os.replace(staged, settings)
        except BaseException:
            os.unlink(staged)
            raise
        print("droiddeck-game-env: Ubisoft Connect overlay turned off", file=sys.stderr)
    except (OSError, UnicodeDecodeError) as error:
        print("droiddeck-game-env: Ubisoft Connect overlay left as is (%s)" % error, file=sys.stderr)


def offline_without_anticheat(command, env):
    if (env.get("DROIDDECK_ANTICHEAT_OFFLINE") != "1" or len(command) <= 2
            or command[1] != "waitforexitandrun"
            or not re.fullmatch(r"start_protected_game(?:_?x64|_?64)?\.exe",
                                os.path.basename(command[2]), re.IGNORECASE)):
        return command
    folder = os.path.dirname(command[2])
    try:
        with open(os.path.join(folder, "EasyAntiCheat", "settings.json"), encoding="utf-8-sig") as source:
            executable = json.load(source).get("executable")
    except (OSError, ValueError, AttributeError):
        return command
    if not isinstance(executable, str) or not executable:
        return command
    relative = os.path.normpath(executable.replace("\\", "/"))
    game = os.path.join(folder, relative)
    if os.path.isabs(relative) or relative.startswith("..") or not os.path.isfile(game):
        return command
    root = os.path.realpath(folder)
    if os.path.commonpath((root, os.path.realpath(game))) != root:
        return command
    if os.path.normcase(os.path.abspath(game)) == os.path.normcase(os.path.abspath(command[2])):
        return command
    print("droiddeck-game-env: started without Easy Anti-Cheat (offline only)", file=sys.stderr)
    return command[:2] + [game] + command[3:]


def engine_fixes(exe, args):
    game = Game(exe, args)
    env, extra, notes = {}, [], []
    for check in FIXES:
        found = check(game)
        if found:
            for name, value in found[0].items():
                if name == "WINEDLLOVERRIDES" and env.get(name):
                    value = env[name] + ";" + value
                env[name] = value
            extra += found[1]
            notes.append(found[2])
    return env, extra, notes


def win_components(compat, app_id):
    if not compat:
        return ""
    try:
        module = runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-wincomponents"))
        names, notes = module["apply"](compat.rstrip("/"), app_id)
        for note in notes:
            print("droiddeck-game-env: " + note, file=sys.stderr)
        return module["overrides_value"](names)
    except Exception as error:
        print("droiddeck-game-env: Windows components not applied (%s)" % error, file=sys.stderr)
        return ""


def mali_defaults():
    try:
        return runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-mali-defaults"))
    except Exception as error:
        print("droiddeck-game-env: Mali defaults not applied (%s)" % error, file=sys.stderr)
        return None


def game_gpu(env):
    if GAME_TU_DEBUG not in env:
        return env
    result = env.copy()
    value = result.pop(GAME_TU_DEBUG)
    if value:
        result["TU_DEBUG"] = value
    else:
        result.pop("TU_DEBUG", None)
    return result


def vram_cap(env):
    value = env.get("BL_VRAM_MB", "")
    if not re.fullmatch(r"[1-9][0-9]{0,6}", value):
        return env
    result = env.copy()
    cap = "dxgi.maxDeviceMemory = %d" % int(value)
    own = result.get("DXVK_CONFIG", "").strip().strip(";").strip()
    result["DXVK_CONFIG"] = cap + "; " + own if own else cap
    return result


def parse_cores(text):
    cores = set()
    for part in text.replace(" ", "").split(","):
        match = re.fullmatch(r"(\d{1,3})(?:-(\d{1,3}))?", part)
        if not match:
            return None
        first, last = int(match.group(1)), int(match.group(2) or match.group(1))
        if last < first:
            return None
        cores.update(range(first, last + 1))
    return cores or None


def online_cores():
    try:
        with open("/sys/devices/system/cpu/online") as f:
            cores = parse_cores(f.read().strip())
    except OSError:
        cores = None
    return cores or os.sched_getaffinity(0) | set(range(os.cpu_count() or 0))


def game_cores(env):
    text = env.get("DROIDDECK_GAME_CORES", "").strip()
    if not text:
        return
    cores = parse_cores(text)
    chosen = cores & online_cores() if cores else None
    if not chosen:
        print("droiddeck-game-env: ignoring game cores %r" % text, file=sys.stderr)
        return
    try:
        os.sched_setaffinity(0, chosen)
        print("droiddeck-game-env: game cores %s" % ",".join(map(str, sorted(chosen))), file=sys.stderr)
    except OSError as error:
        print("droiddeck-game-env: could not use game cores %r (%s)" % (text, error), file=sys.stderr)


def core_speeds(cores, root="/sys/devices/system/cpu"):
    for name in ("cpu_capacity", "cpufreq/cpuinfo_max_freq"):
        speeds = {}
        for core in cores:
            try:
                with open("%s/cpu%d/%s" % (root, core, name)) as f:
                    speeds[core] = int(f.read().strip())
            except (OSError, ValueError):
                break
        else:
            return speeds
    return None


def fastest_first(cores):
    cores = sorted(cores)
    speeds = core_speeds(cores)
    return sorted(cores, key=lambda core: -speeds[core]) if speeds else cores


def proton_cpu_limit(command, env):
    app_id = env.get("SteamGameId", "")
    if not command or not app_id.isdigit():
        return None
    try:
        if os.path.getsize(command[0]) > 4 * 1024 * 1024:
            return None
        with open(command[0], encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    table = re.search(r"^default_cpu_limit = \{(.*?)^\}", text, re.M | re.S)
    match = table and re.search(r'^\s*"%s"\s*:\s*"?(\w+)' % app_id, table.group(1), re.M)
    if not match:
        return None
    value = match.group(1)
    return int(value) if value.isdigit() else value


def cpu_topology(env, command=()):
    if "PROTON_CPU_TOPOLOGY" in env:
        return
    if "WINE_CPU_TOPOLOGY" in env:
        if env["WINE_CPU_TOPOLOGY"]:
            env["PROTON_CPU_TOPOLOGY"] = env["WINE_CPU_TOPOLOGY"]
        return
    picked = bool(env.get("DROIDDECK_GAME_CORES", "").strip() or env.get("BL_GAME_CPUS", "").strip())
    fastest = env.get("DROIDDECK_FASTEST_CORES", "").strip() != "0" and game_id(env) is not None
    if not (picked or fastest):
        return
    try:
        cores = sorted(os.sched_getaffinity(0))
    except OSError:
        return
    online = online_cores()
    if not cores or cores[-1] >= len(online):
        return
    picked = picked and not set(cores) >= online
    if fastest:
        limit = None if picked else proton_cpu_limit(command, env)
        if isinstance(limit, str):
            return
        cores = fastest_first(cores)[:limit or None]
    elif set(cores) >= online:
        return
    if cores == sorted(online):
        return
    env["WINE_CPU_TOPOLOGY"] = env["PROTON_CPU_TOPOLOGY"] = "%d:%s" % (len(cores), ",".join(map(str, cores)))
    print("droiddeck-game-env: Windows sees %d cores (%s)" % (len(cores), env["WINE_CPU_TOPOLOGY"]), file=sys.stderr)


def gl_vsync(env):
    if "vblank_mode" in env or game_id(env) is None:
        return False
    env["vblank_mode"] = "0"
    return True


def game_images(env):
    if game_id(env) is None:
        return False
    env.setdefault("GAMESCOPE_WSI_MIN_IMAGE_COUNT", "8")
    env.setdefault("GAMESCOPE_WSI_ENSURE_MIN_IMAGE_COUNT", "1")
    return True


GAME_DRIVER = "DROIDDECK_GAME_DRIVER"


def game_driver_choice(config, app_id):
    """The game's own driver choice from its environment entries: "bridge", "session" or None (follow the app)."""
    if not app_id or not isinstance(config, dict):
        return None
    games = config.get("games", {})
    choice = games.get(app_id, {}).get(GAME_DRIVER) if isinstance(games, dict) and isinstance(games.get(app_id), dict) else None
    return choice if choice in ("bridge", "session") else None


def session_driver(env):
    """The session's Vulkan driver as the game inherits it, for the driver line."""
    files = env.get("VK_DRIVER_FILES") or env.get("VK_ICD_FILENAMES") or ""
    if env.get("BL_SESSION_PANVK") == "1":
        name = "PanVK"
    elif "mali_bridge" in files.lower():
        name = "Mali system driver (bridge)"
    else:
        name = "the runtime's Vulkan driver"
    return "session driver (%s), %s" % (name, files or "the Vulkan loader's default")


def game_driver(command, env, choice=None, native=False):
    """BL_VK_GAME_DRIVER (set by the session when the Mali system driver, the bridge, is chosen): the game
    process draws with that Vulkan ICD while Steam, gamescope and the desktop stay on the session's driver.
    A game's DROIDDECK_GAME_DRIVER entry overrides the app's choice: "session" keeps the game on the session's
    driver, "bridge" puts it on the bridge (BL_VK_BRIDGE_ICD, exported whenever the bridge is installed).
    Only the game's own launch gets it (Proton's waitforexitandrun); a game's environment entry can still
    override VK_DRIVER_FILES afterwards. The bridge runs the phone's Android Vulkan driver through libhybris,
    which needs its vendor namespace (the shim also sets it when missing, but a running Wine process has other
    threads reading the environment). Every game launch prints one "game driver:" line with the reason, on both
    paths, so a report says which driver the game had."""
    if not native and (len(command) < 2 or command[1] != "waitforexitandrun"):
        return env
    icd = env.get("BL_VK_GAME_DRIVER", "")
    if choice == "session":
        icd, why = "", "the game's own setting (DROIDDECK_GAME_DRIVER=session)"
    elif choice == "bridge":
        icd = icd or env.get("BL_VK_BRIDGE_ICD", "")
        why = ("the game's own setting (DROIDDECK_GAME_DRIVER=bridge)" if icd else
               "the game's own setting asks for the bridge (DROIDDECK_GAME_DRIVER=bridge), but no bridge is installed")
    else:
        why = "the app's setting (games use the Mali system driver)" if icd else "the app's setting (games use the session driver)"
    if icd and not os.access(icd, os.R_OK):
        print("droiddeck-game-env: game driver %s is not readable; using the session's" % icd, file=sys.stderr)
        icd, why = "", "the bridge's manifest %s is not readable" % icd
    if not icd:
        print("droiddeck-game-env: game driver: %s; %s" % (session_driver(env), why), file=sys.stderr)
        return env
    print("droiddeck-game-env: game driver: Mali system driver (bridge), %s; %s" % (icd, why), file=sys.stderr)
    res = dict(
        env,
        VK_DRIVER_FILES=icd,
        VK_ICD_FILENAMES=icd,
        HYBRIS_USE_VENDOR_NAMESPACE="1",
        ENABLE_MALI_WSI="1",
        ENABLE_MALI_COMPAT="1",
        ENABLE_GAMESCOPE_WSI="1",
    )
    res.pop("VK_INSTANCE_LAYERS", None)
    if native:
        # A native Linux game under droiddeck-fex (Quake II RTX): FEX's Vulkan thunk repacks only X11 surfaces, so SDL
        # stays on X11 and the gamescope WSI layer makes the Wayland hop host-side (docs/games/quake2rtx.md). The
        # Proton/DXVK keys below are inert for a native binary.
        res.setdefault("SDL_VIDEODRIVER", "x11")
    # Measuring switches from the app (Performance > Mali system driver): the WSI layer's present-rate log
    # (/root/mali-wsi-fps.txt) and the compat layer's GPU timing (/root/mali-gputime-*.txt). A game's own entry wins.
    if env.get("BL_BRIDGE_FPS_LOG", "0") == "1":
        res.setdefault("MALI_WSI_FPS", "1")
    if env.get("BL_BRIDGE_GPU_TIME", "0") == "1":
        res.setdefault("MALI_COMPAT_GPU_TIME", "1")
    # Workarounds for the bridge, switchable in the app (Performance > Mali system driver), both on unless the
    # session says 0: vkd3d-proton renders black frames with descriptor buffers on the vendor driver, and DXVK's
    # pipeline-library links (no fast linking there) stalled Tomb Raider to 22 FPS. A game's own DXVK_CONFIG from the
    # app's game settings is appended after this by apply_config.
    if env.get("BL_BRIDGE_NO_DESCRIPTOR_BUFFER", "1") != "0":
        disabled = [e for e in res.get("VKD3D_DISABLE_EXTENSIONS", "").split(",") if e]
        if "VK_EXT_descriptor_buffer" not in disabled:
            disabled.append("VK_EXT_descriptor_buffer")
        res["VKD3D_DISABLE_EXTENSIONS"] = ",".join(disabled)
    # vkd3d-proton on UMA Mali needs no_upload_hvv to avoid missing/corrupted geometry (trees, bridges, LODs)
    vkd3d_cfg = [c for c in res.get("VKD3D_CONFIG", "").split(",") if c]
    if "no_upload_hvv" not in vkd3d_cfg:
        vkd3d_cfg.append("no_upload_hvv")
    res["VKD3D_CONFIG"] = ",".join(vkd3d_cfg)
    if env.get("BL_BRIDGE_NO_PIPELINE_LIBRARY", "1") != "0":
        own = res.get("DXVK_CONFIG", "").strip().rstrip(";").strip()
        gpl = "dxvk.enableGraphicsPipelineLibrary = False"
        res["DXVK_CONFIG"] = own + "; " + gpl if own else gpl
    return res


RT_VULKAN = "BL_RT_VULKAN"
RT_DXR = "BL_DXR"
# Ray queries on the Mali system driver: the blob enforces descriptor pool counts, so the compat layer pads and scales
# the pools (Quake II RTX, docs/games/quake2rtx.md, WIN). The app's switch (Performance > Ray tracing) or a game's
# entry sets BL_RT_VULKAN=1; a game's own MALI_COMPAT_DESC_POOL_* keys win.
RT_VULKAN_ENV = {"MALI_COMPAT_DESC_POOL_PAD": "4", "MALI_COMPAT_DESC_POOL_SCALE": "8"}
# DX12 ray tracing (BL_DXR=1): the one env DXR was proven with, The Witcher 3 on Blobferry 0.3.0 (layer 94dcc32d;
# docs/games/witcher3.md "Installed", w3-rt-1116 RT ON 11.6 fps with real RT work, release-gate-1115 R4 PASS):
# VKD3D_CONFIG=dxr,dxr11,no_upload_hvv,single_queue,extra_rtas_sync, MALI_COMPAT_RT_PIPELINE=1, RT_SIZE_PAD=0 (padding
# lost the process). no_upload_hvv is the bridge's own flag (game_driver; a recipe's nodxr replaces it, so it is put
# back here). extra_rtas_sync was in every DXR run (W3, Control, RE Village); single_queue only in The Witcher 3's
# (it is a dead lever for HZD), so it is that game's alone.
DXR_VKD3D = ("dxr", "dxr11")
DXR_VKD3D_BRIDGE = "no_upload_hvv"
DXR_VKD3D_EXTRA = ("extra_rtas_sync",)
DXR_VKD3D_GAMES = {"292030": ("single_queue",)}
DXR_ENV = {"MALI_COMPAT_RT_PIPELINE": "1", "MALI_COMPAT_RT_SIZE_PAD": "0"}
BLOBFERRY_CAPABILITIES = "/usr/share/blobferry/capabilities.json"


def dxr_supported(path=None):
    """Whether the installed Blobferry says DX12 ray tracing works: "dxr" (else "rt_pipeline") is "supported", top level
    or under "capabilities", the same reading as the app's BlobferryPackage.dxrCapability. No file: not supported."""
    try:
        with open(path or BLOBFERRY_CAPABILITIES, encoding="utf-8") as source:
            caps = json.load(source)
    except (OSError, ValueError):
        return False
    if not isinstance(caps, dict):
        return False
    caps = caps.get("capabilities") if isinstance(caps.get("capabilities"), dict) else caps
    return (caps.get("dxr") or caps.get("rt_pipeline")) == "supported"


def own_keys(config, app_id):
    """The names the user set: the game's own entry and the user's shared settings (the app publishes their names as
    userShared), the same as droiddeck-mali-defaults.user_keys."""
    if not isinstance(config, dict):
        return set()
    names = set()
    shared = config.get("userShared")
    if isinstance(shared, list):
        names.update(name for name in shared if isinstance(name, str))
    games = config.get("games")
    game = games.get(app_id) if isinstance(games, dict) and app_id else None
    if isinstance(game, dict):
        names.update(game)
    return names


def ray_tracing(env, own=(), app_id=None):
    """BL_RT_VULKAN=1: the descriptor-pool keys for Vulkan ray queries. BL_DXR=1 (the app's switch, Performance > Ray
    tracing, or the game's own BL_DXR entry, which wins over the switch): MALI_COMPAT_RT_PIPELINE=1 and
    MALI_COMPAT_RT_SIZE_PAD=0 for the Blobferry compat layer, and on the Mali system driver, when the installed
    Blobferry says "dxr": "supported", vkd3d-proton's DXR flags: VKD3D_CONFIG loses nodxr and gets dxr,dxr11 in front,
    then its other flags, the bridge's no_upload_hvv, the game's own DXR flags (DXR_VKD3D_GAMES) and extra_rtas_sync.

    Precedence for VKD3D_CONFIG, highest first: (1) the user's own value (own: the names the user set, the game's entry
    and the user's shared settings, the same ones droiddeck-mali-defaults leaves alone) is never touched, even when it
    says nodxr; (2) BL_DXR=1 as above, on whatever (3) and (4) gave; (3) the env defaults (droiddeck-mali-defaults,
    e.g. nodxr; they replace (4) as before); (4) the launch's inherited VKD3D_CONFIG plus the bridge's no_upload_hvv.
    A game's own MALI_COMPAT_RT_* value wins over DXR_ENV. With BL_DXR 0 or unset nothing changes. Never VKD3D_FEATURE_LEVEL here (12_1 stays; 12_2 crashed Elden Ring, docs/agents/env-defaults-1106.md)."""
    res = dict(env)
    if env.get(RT_VULKAN) == "1":
        for name, value in RT_VULKAN_ENV.items():
            res.setdefault(name, value)
        print("droiddeck-game-env: ray tracing (Vulkan ray query): descriptor pools padded/scaled", file=sys.stderr)
    if env.get(RT_DXR) != "1":
        return res
    for name, value in DXR_ENV.items():
        res.setdefault(name, value)
    flags = [flag for flag in res.get("VKD3D_CONFIG", "").split(",") if flag]
    if "VKD3D_CONFIG" in own:
        why = "your own VKD3D_CONFIG is kept" + (" (nodxr, or no dxr: DXR stays off)" if "nodxr" in flags or "dxr" not in flags else "")
    elif env.get("ENABLE_MALI_COMPAT") != "1":
        why = "not on the Mali system driver, VKD3D_CONFIG unchanged"
    elif not dxr_supported():
        why = "the installed Blobferry does not report DX12 ray tracing, VKD3D_CONFIG unchanged"
    else:
        rest = [flag for flag in flags if flag != "nodxr" and flag not in DXR_VKD3D]
        for flag in (DXR_VKD3D_BRIDGE,) + DXR_VKD3D_GAMES.get(app_id, ()) + DXR_VKD3D_EXTRA:
            if flag not in rest:
                rest.append(flag)
        res["VKD3D_CONFIG"] = ",".join(DXR_VKD3D + tuple(rest))
        why = "VKD3D_CONFIG=" + res["VKD3D_CONFIG"]
    print("droiddeck-game-env: ray tracing (DXR): %s" % why, file=sys.stderr)
    return res


def apply_config(env, config, app_id, fixes=None):
    if config.get("version") != 1:
        raise ValueError("unsupported environment configuration")
    result = env.copy()
    entries = dict(config.get("shared", {}))
    for name, value in (fixes or {}).items():
        if name == "WINEDLLOVERRIDES" and entries.get(name, env.get(name)):
            value = entries.get(name, env.get(name)) + ";" + value
        entries[name] = value
    entries.update(config.get("games", {}).get(app_id, {}))
    for name, value in entries.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise ValueError("invalid environment name")
        if value is None:
            result.pop(name, None)
        elif isinstance(value, str) and "\0" not in value and len(value) <= 8192:
            result[name] = value
        else:
            raise ValueError("invalid environment value")
    game_dxvk = config.get("dxvkConfigGames", {})
    if not isinstance(game_dxvk, dict):
        raise ValueError("invalid game dxvk configuration")
    dxvk = game_dxvk.get(app_id, config.get("dxvkConfig"))
    if dxvk is not None:
        if not isinstance(dxvk, str) or "\0" in dxvk or len(dxvk) > 8192:
            raise ValueError("invalid dxvk configuration")
        if dxvk:
            own = result.get("DXVK_CONFIG", "").strip().rstrip(";").strip()
            result["DXVK_CONFIG"] = own + "; " + dxvk if own else dxvk
    return result


GAME_DEBUG_CHANNELS = (
    "timestamp", "pid", "tid", "seh", "unwind", "threadname", "debugstr", "loaddll", "mscoree",
)
WINE_DEBUG_SELECTOR = re.compile(r"(?:(trace|warn|err|fixme))?([+-])([A-Za-z_][A-Za-z0-9_]*)")


def game_debug_channels(*values):
    selectors = {}
    for value in values:
        if not isinstance(value, str) or "\0" in value or len(value) > 8192:
            continue
        for part in value.split(","):
            part = part.strip()
            match = WINE_DEBUG_SELECTOR.fullmatch(part)
            if match is None:
                continue
            key = (match[1] or "", match[3])
            selectors.pop(key, None)
            selectors[key] = part
    for channel in GAME_DEBUG_CHANNELS:
        key = ("", channel)
        selectors.pop(key, None)
        selectors[key] = "+" + channel
    formatted = ",".join(selectors.values())
    if len(formatted) > 8192:
        formatted = ",".join("+" + channel for channel in GAME_DEBUG_CHANNELS)
    return formatted


def apply_game_debug_logs(env, config, debug_dir):
    if not isinstance(config, dict) or config.get("version") != 1 or config.get("gameDebugLogs") is not True:
        return env
    if (not isinstance(debug_dir, str) or "\0" in debug_dir or len(debug_dir) > 8192
            or not os.path.isabs(debug_dir) or not os.path.isdir(debug_dir)):
        print("droiddeck-game-env: game debug logs skipped; session log directory unavailable", file=sys.stderr)
        return env
    result = dict(env)
    result.update({
        "PROTON_LOG": "1",
        "PROTON_LOG_DIR": debug_dir,
        "PROTON_CRASH_REPORT_DIR": debug_dir,
        "DXVK_LOG_PATH": debug_dir,
        "DXVK_LOG_LEVEL": "debug",
        "VKD3D_DEBUG": "info",
        "WINEDEBUG": game_debug_channels(env.get("WINEDEBUG"), env.get("PROTON_LOG")),
    })
    return result


# Default game logs, every game on every driver path: Proton's log file (~/steam-<SteamGameId>.log, in the report)
# with Wine's err lines, DXVK's info lines (adapter, driver and extensions, once per device) and vkd3d-proton's warn
# lines. None of them writes per frame or per call. PROTON_LOG=1 also switches FEX's own logger on (Proton writes
# SilentLog 0), which logs every handled unaligned atomic: 4.2 M lines, 420 MB in one Watch Dogs 2 run with the err-only
# WINEDEBUG. FEX_SILENTLOG=1 (its env layer wins over Proton's file) keeps that off. Wine's exception/DLL tracing
# (+seh,+unwind,+loaddll, Proton's own PROTON_LOG=1 WINEDEBUG) and the FEX log stay behind the app's debug-log switches.
GAME_LOGS = {"PROTON_LOG": "1", "DXVK_LOG_LEVEL": "info", "VKD3D_DEBUG": "warn"}
GAME_LOGS_QUIET = {"WINEDEBUG": "+timestamp,+pid,+tid,fixme-all", "FEX_SILENTLOG": "1"}


def game_logs(env, heavy=False, own=()):
    """The default log keys, each only when unset and not one of the user's own game-setting names ([own]: a setting
    that removes a key keeps it removed): the user's launch options and game settings win. An explicit PROTON_LOG=0 (or
    empty) turns the Proton log and these defaults off; an explicit PROTON_LOG=1 gets Proton's own WINEDEBUG trace."""
    if "PROTON_LOG" in env and env["PROTON_LOG"] in ("", "0"):
        print("droiddeck-game-env: game logs off (PROTON_LOG=%s); no Wine/DXVK log for this launch" % env["PROTON_LOG"],
              file=sys.stderr)
        return env
    result = dict(env)
    defaults = dict(GAME_LOGS)
    heavy = heavy or env.get("BL_BRIDGE_DEBUG_LOGS", "0") == "1"
    if not heavy:
        defaults["FEX_SILENTLOG"] = GAME_LOGS_QUIET["FEX_SILENTLOG"]
        # A PROTON_LOG the user set (launch option, game setting, the report's "next launch" switch) asks for Proton's
        # own WINEDEBUG trace; the FEX log still needs a debug switch.
        if "PROTON_LOG" not in env:
            defaults["WINEDEBUG"] = GAME_LOGS_QUIET["WINEDEBUG"]
    for name, value in defaults.items():
        if name not in own:
            result.setdefault(name, value)
    print("droiddeck-game-env: game logs: %s, %s" % (
        " ".join("%s=%s" % (name, result[name]) for name in ("PROTON_LOG", "WINEDEBUG", "DXVK_LOG_LEVEL", "VKD3D_DEBUG",
                                                             "FEX_SILENTLOG") if name in result),
        "with the debug tracing" if heavy else "errors and warnings only"), file=sys.stderr)
    return result


def proton_log(env):
    """Where Proton writes this launch's log, or None when it writes none."""
    if env.get("PROTON_LOG", "") in ("", "0"):
        return None
    game = env.get("SteamGameId", "")
    if not re.fullmatch(r"[0-9]+", game):
        return None
    folder = env.get("PROTON_LOG_DIR") or env.get("HOME") or ""
    return os.path.join(folder, "steam-%s.log" % game) if os.path.isabs(folder) else None


# The low byte of the NTSTATUS a crashed Windows program exits with (Wine passes it on as the exit status).
NTSTATUS_LOW_BYTE = {
    0x05: "0xC0000005 access violation",
    0x1D: "0xC000001D illegal instruction",
    0xFD: "0xC00000FD stack overflow",
    0x09: "0xC0000409 stack buffer overrun / fail-fast",
    0x96: "0xC0000096 privileged instruction",
}
LOG_HEAD = 512 * 1024
LOG_TAIL = 1024 * 1024
SUMMARY_LINES = 20
CAUSE_LINES = 12
SUMMARY_LINE = re.compile(r"(?:^|:)(?:err|warn):|\b(?:error|fatal|failed|unhandled|exception)\b", re.IGNORECASE)
HAL_LINE = re.compile(r"mali-bridge: (?:vendor HAL|hybris)")
# Start-up lines every Proton launch here prints; they never name the failure (docs/analysis/yooka-rc2-1120.md section 4).
STARTUP_NOISE = re.compile("|".join((
    r"ld\.so: object '[^']*gameoverlayrenderer\.so' from LD_PRELOAD cannot be preloaded",
    r"err:wineusb:usb_init Failed to initialize libusb",
    r"err:ntoskrnl:ZwLoadDriver failed to create driver .*winebth",
    r"err:steamclient:steamclient_init_registry Failed to connect to Steam",
    r"OpenXR: Unable to get required Vulkan",
    r"D3D11DeviceFeatures: Some formats not supported for resource sharing",
    r"QueryInterface: Unknown interface query",
    r"^warn:\s+(?:<redacted:guid>|\{?[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\}?)\s*$",
    r"MakeWindowAssociation: Ignoring flags",
    r"xdg_backend:.*Compositor released us but we were not acquired",
    r"Proton: Error while copying to .*(?:amdxcffx64|igdext64)\.dll",
    r"Proton: Error: unable to use parent for game drive",
    r"unable to check /proc/modules for NV driver presence",
    r"Failed to read /etc/machine-id",
    r"err:nsi:poll_events bind failed",
    r"err:hid:(?:get_container_id_for_usb_udev_device|sdl_bus_init|udev_bus_init)",
)))
# What Wine prints while a game the session stopped (SIGINT/SIGTERM/SIGHUP/SIGKILL) is torn down.
TEARDOWN_NOISE = re.compile("|".join((
    r"err:virtual:virtual_setup_exception nested exception on signal stack",
    r"^terminate called without an active exception",
    r"err:seh:call_seh_handlers invalid frame",
    r"err:seh:NtRaiseException Exception frame is not in stack limits",
    r"^wine client error:\S+: write: Bad file descriptor",
    r"skipping destruction \(fork without exec\?\)",
)))
KNOWN_CAUSE = re.compile("|".join((
    r"VK_ERROR_DEVICE_LOST",
    r"GROUP_ERROR_FATAL|TRANSLATION_FAULT|GPU (?:page )?fault",
    r"hybris_dlopen\(.*\) failed",
    r"mali-bridge: (?:vendor HAL candidate rejected|no vendor HAL|vendor HAL .*(?:missing|not found|failed))",
)), re.IGNORECASE)
# A swapchain recreation is routine; it is a cause only next to a swapchain destroy that never returned.
WSI_CAUSE = re.compile(r"\[Gamescope WSI\] Forcing swapchain recreation|VK_ERROR_OUT_OF_DATE_KHR", re.IGNORECASE)
DESTROYING = re.compile(r"\[Gamescope WSI\] Destroying swapchain: (0x[0-9a-fA-F]+)")
DESTROYED = re.compile(r"\[Gamescope WSI\] Destroyed swapchain: (0x[0-9a-fA-F]+)")
WINE_LINE = re.compile(r"^(\d+\.\d+):[0-9a-fA-F]+:[0-9a-fA-F]+:(err|warn|fixme|trace):")
WINE_ERR_SECONDS = 30
# The signals a stop sends (the session, Steam's Stop); SIGKILL is the low-memory killer's, not a stop.
STOP_SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)


def read_window(path, start, size):
    with open(path, "rb") as source:
        source.seek(start)
        return source.read(size)


def log_excerpt(path):
    """(head, tail, skipped) of a log, each cut at line ends: the whole file when it is small."""
    size = os.path.getsize(path)
    if size <= LOG_HEAD + LOG_TAIL:
        return read_window(path, 0, size), b"", 0
    head = read_window(path, 0, LOG_HEAD)
    head = head[:head.rfind(b"\n") + 1]
    tail = read_window(path, size - LOG_TAIL, LOG_TAIL)
    tail = tail[tail.find(b"\n") + 1:]
    return head, tail, size - len(head) - len(tail)


def exit_text(returncode, seconds):
    if returncode < 0:
        try:
            name = signal.Signals(-returncode).name
        except ValueError:
            name = "signal %d" % -returncode
        return "game ended by %s (signal %d) after %.0f s" % (name, -returncode, seconds)
    text = "game exited with status %d after %.0f s" % (returncode, seconds)
    if returncode in NTSTATUS_LOW_BYTE:
        text += " (if it crashed: low byte of %s)" % NTSTATUS_LOW_BYTE[returncode]
    return text


def repeat_key(line):
    """A line without its Wine time/pid/tid prefix and its addresses: repeats of one message share it."""
    line = WINE_LINE.sub(r"\2:", line)
    return re.sub(r"0x[0-9a-fA-F]+", "0x?", line).strip()


def hung_destroys(lines):
    """Indexes of `Destroying swapchain` lines the WSI layer never followed with `Destroyed swapchain`."""
    open_destroys = {}
    for index, line in enumerate(lines):
        match = DESTROYING.search(line)
        if match:
            open_destroys[match.group(1)] = index
            continue
        match = DESTROYED.search(line)
        if match:
            open_destroys.pop(match.group(1), None)
    return set(open_destroys.values())


def summary_lines(lines, stopped):
    """(cause lines, other lines, hung destroy lines) of a Proton log, each in log order: start-up noise (and teardown
    noise when a stop ended the game) left out, repeats folded into their last copy. Causes are the known-cause
    patterns and a swapchain destroy that never returned (with the recreation lines before it), then, for a game that
    was not stopped, Wine errors of the last 30 s before the log ends."""
    hung = hung_destroys(lines)
    times = [float(m.group(1)) for m in map(WINE_LINE.match, lines) if m]
    end = max(times) if times else None
    picked = {}
    for index, line in enumerate(lines):
        if STARTUP_NOISE.search(line) or (stopped and TEARDOWN_NOISE.search(line)):
            continue
        wine = WINE_LINE.match(line)
        if index in hung or KNOWN_CAUSE.search(line) or (hung and WSI_CAUSE.search(line)):
            rank = 2
        elif (not stopped and wine and wine.group(2) == "err" and end is not None
              and float(wine.group(1)) >= end - WINE_ERR_SECONDS):
            rank = 1
        else:
            rank = 0
        if not rank and not SUMMARY_LINE.search(line):
            continue
        key = repeat_key(line)
        _, _, count, was = picked.get(key, (0, "", 0, 0))
        picked[key] = (index, line, count + 1, max(rank, was))
    def shown(item):
        _, line, count, _ = item
        return line if count == 1 else "%s (%d times)" % (line, count)
    ordered = sorted(picked.values())
    strong = [item for item in ordered if item[3] == 2][-CAUSE_LINES:]
    late = [item for item in ordered if item[3] == 1]
    late = late[-(CAUSE_LINES - len(strong)):] if CAUSE_LINES > len(strong) else []
    causes = sorted(strong + late)
    others = [item for item in ordered if not item[3]]
    room = SUMMARY_LINES - len(causes)
    others = others[-room:] if room > 0 else []
    return [shown(item) for item in causes], [shown(item) for item in others], [lines[i] for i in sorted(hung)]


def game_finished(env, returncode, seconds):
    """After the game: its exit in the session log and, for a failed exit, the bridge's HAL lines, the known-cause
    lines and the last other err/warn lines of its Proton log (session.log is in the problem report)."""
    print("droiddeck-game-env: %s; ended at unix time %d" % (exit_text(returncode, seconds), time.time()), file=sys.stderr)
    if returncode == 0:
        return
    path = proton_log(env)
    if not path:
        print("droiddeck-game-env: no Proton log for this launch (PROTON_LOG off)", file=sys.stderr)
        return
    if not os.path.isfile(path):
        print("droiddeck-game-env: no Proton log found at %s" % path, file=sys.stderr)
        return
    head, tail, _ = log_excerpt(path)
    lines = (head + b"\n" + tail).decode("utf-8", "replace").splitlines()
    hal = []
    for line in lines:
        if HAL_LINE.search(line) and line not in hal:
            hal.append(line)
    hal = hal[:5]
    stopped = returncode < 0 and -returncode in STOP_SIGNALS
    causes, last, hung = summary_lines(lines, stopped)
    if hung:
        print("droiddeck-game-env: likely cause: a swapchain destroy never returned (%s has no Destroyed line)%s"
              % (hung[-1].strip(), "; the game hung until it was stopped" if stopped else ""), file=sys.stderr)
    print("droiddeck-game-env: failure summary from %s (%d bridge HAL lines, %d known-cause lines, last %d other "
          "err/warn lines; start-up%s noise and repeats left out):"
          % (os.path.basename(path), len(hal), len(causes), len(last), "/teardown" if stopped else ""), file=sys.stderr)
    for line in hal:
        print("droiddeck-game-env: | " + line[:400], file=sys.stderr)
    for line in causes:
        print("droiddeck-game-env: ! " + line[:400], file=sys.stderr)
    for line in last:
        print("droiddeck-game-env: | " + line[:400], file=sys.stderr)


def sync_config(config, app_id):
    games = config.get("games", {})
    return {
        "version": config.get("version"),
        "shared": {name: value for name, value in config.get("shared", {}).items() if name in SYNC_KEYS},
        "games": {app_id: {name: value for name, value in games.get(app_id, {}).items() if name in SYNC_KEYS}},
    }


def load_sync():
    try:
        return runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-esync"))
    except Exception as error:
        print("droiddeck-game-env: sync selection failed (%s); stock launch" % error, file=sys.stderr)
        return None


def select_sync(command, env, sync=None):
    try:
        sync = sync if sync is not None else load_sync()
        if sync is None:
            return command, env
        chosen, chosen_env = sync["select"](command, env)
        if chosen and all(isinstance(value, str) for value in chosen) and isinstance(chosen_env, dict):
            return list(chosen), dict(chosen_env)
    except Exception as error:
        print("droiddeck-game-env: sync selection failed (%s); stock launch" % error, file=sys.stderr)
    return command, env


def record_stock(sync, command, env):
    try:
        if sync is not None and "record" in sync:
            sync["record"](command, env)
    except Exception as error:
        print("droiddeck-game-env: stock launch not recorded (%s)" % error, file=sys.stderr)


def without_pack(chosen_env, env):
    result = dict(chosen_env)
    for name in PACK_KEYS:
        if name in env:
            result[name] = env[name]
        else:
            result.pop(name, None)
    return result


SSBS_LIB = "/usr/local/lib/libssbs.so"


def force_ssbs(command, env):
    if env.get("DROIDDECK_FORCE_SSBS", "").lower() not in ("1", "on", "true", "yes"):
        return env
    proton = os.path.dirname(command[0]) if command else ""
    if not os.path.isdir(os.path.join(proton, "files/lib/wine/aarch64-unix")):
        print("droiddeck-game-env: force SSBS asked for, but this Proton is not an ARM64 one; left off", file=sys.stderr)
        return env
    if not os.path.isfile(SSBS_LIB):
        print("droiddeck-game-env: force SSBS asked for, but %s is missing; left off" % SSBS_LIB, file=sys.stderr)
        return env
    parts = [p for p in re.split(r"[:\s]+", env.get("LD_PRELOAD", "")) if p]
    if SSBS_LIB not in parts:
        env = dict(env, LD_PRELOAD=":".join(parts + [SSBS_LIB]))
        print("droiddeck-game-env: force SSBS on (libssbs.so preloaded)", file=sys.stderr)
    return env


EVALUATOR_SCRIPT = re.compile(r"(?:^|[\\/])evaluatorscript_[0-9]+\.vdf$", re.IGNORECASE)


def mark_install_scripts(command, env):
    if not any(arg.lower().replace("\\", "/").endswith("iscriptevaluator.exe") for arg in command):
        return []
    root = env.get("BL_X64_STEAM_ROOT") or env.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or str(Path.home() / ".local/share/Steam")
    scripts = [str(Path(root) / arg.replace("\\", "/")) for arg in command if EVALUATOR_SCRIPT.search(arg)]
    scripts = [path for path in scripts if os.path.isfile(path)]
    if not scripts:
        return []
    try:
        subprocess.run([SEED_REDISTS, root], env=dict(env, DROIDDECK_SEED_SCRIPTS="\n".join(scripts)),
                       stdout=sys.stderr, timeout=60, check=False)
    except (OSError, subprocess.SubprocessError) as error:
        print("droiddeck-game-env: install scripts not marked (%s)" % error, file=sys.stderr)
    return scripts


INSTALL_STAMP = ".droiddeck-install-scripts"
VDF_TOKEN = re.compile(r'"((?:[^"\\]|\\.)*)"|([{}])')


def read_vdf(text):
    tokens = iter(VDF_TOKEN.findall(text))

    def block():
        items = []
        for word, brace in tokens:
            if brace == "}":
                return items
            if brace:
                raise ValueError("a block without a name")
            value, opens = next(tokens, ("", "}"))
            if opens == "}":
                raise ValueError("a name without a value")
            items.append((re.sub(r"\\(.)", r"\1", word), block() if opens else re.sub(r"\\(.)", r"\1", value)))
        return items

    return block()


def run_keys(items, appid=""):
    appid = next((value for name, value in items if name.lower() == "appid" and isinstance(value, str)), appid)
    found = set()
    for name, value in items:
        if not isinstance(value, list):
            continue
        if any(isinstance(v, str) and re.fullmatch(r"process [0-9]+", n.lower()) for n, v in value):
            key = next((v for n, v in value if n.lower() == "hasrunkey" and isinstance(v, str)),
                       "HKEY_LOCAL_MACHINE\\Software\\Valve\\Steam\\Apps\\" + appid)
            found.add((key.lower(), name.lower()))
        found |= run_keys(value, appid)
    return found


def registry_values(path):
    found, section = set(), None
    with open(path, encoding="utf-8", errors="replace") as reg:
        for line in reg:
            if line.startswith("["):
                section = line[1:line.find("]")].replace("\\\\", "\\").lower() if "]" in line else None
            elif section and line.startswith('"') and '"=' in line:
                found.add((section, line[1:line.index('"=')].replace("\\\\", "\\").lower()))
    return found


def has_run(key, value, values):
    path = key[len("hkey_local_machine\\"):] if key.startswith("hkey_local_machine\\") else None
    if path is None:
        return False
    views = [path]
    if path.startswith("software\\"):
        views.append("software\\wow6432node\\" + path[len("software\\"):])
    return any((view, value) in values for view in views)


def scripts_digest(scripts):
    digest = hashlib.sha256()
    for path in sorted(scripts):
        digest.update(os.path.basename(path).encode() + b"\0")
        digest.update(Path(path).read_bytes())
    return digest.hexdigest()


def install_scripts_done(scripts, env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    try:
        if (prefix / INSTALL_STAMP).read_text().strip() != scripts_digest(scripts):
            return False
        keys = set()
        for path in scripts:
            keys |= run_keys(read_vdf(Path(path).read_text(encoding="utf-8", errors="replace")))
        values = registry_values(prefix / "system.reg")
    except (OSError, ValueError):
        return False
    return bool(keys) and all(has_run(key, value, values) for key, value in keys)


def record_install_scripts(digest, env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    try:
        if prefix.is_dir():
            staged = prefix / (INSTALL_STAMP + ".tmp")
            staged.write_text(digest + "\n")
            staged.replace(prefix / INSTALL_STAMP)
    except OSError as error:
        print("droiddeck-game-env: install scripts not recorded (%s)" % error, file=sys.stderr)


def directaudio_settings(env):
    if "directaudio" not in env.get("WINE_AUDIO_DRIVER", "").split(","):
        return env
    for name, value in list(env.items()):
        if name.startswith("AUDIO_DIRECT_"):
            env["BANNER_" + name] = value
    return env


DIRT_GAMES = {"dirt3_game": "dirt3", "showdown": "dirtshowdown", "showdown_avx": "dirtshowdown"}
DIRT_WS2 = "/usr/local/lib/droiddeck-dirt/ws2_32.dll"
DIRT_MARKER = b"droiddeck-dirt-ws2_32"
DIRT_FIXED = "showdown_avx.exe".encode("utf-16-le")
DIRT_SAVED = ".droiddeck-original"


def dirt_telemetry_on(prefix, game):
    try:
        folders = [f for f in (Path(prefix) / "pfx/drive_c/users/steamuser/Documents/My Games").iterdir()
                   if f.name.lower().replace(" ", "") == game]
    except OSError:
        return False
    for folder in folders:
        try:
            text = (folder / "hardwaresettings/hardware_settings_config.xml").read_text(encoding="latin-1")
        except OSError:
            continue
        for tag in ("udp", "motion"):
            element = re.search(r"<%s\s[^>]*>" % tag, text)
            if element:
                attrs = dict(re.findall(r'\s(\w+)="([^"]*)"', element.group(0)))
                return attrs.get("enabled") == "true" and attrs.get("ip", "").lower() not in ("", "dbox")
    return False


def proton_ws2(proton):
    return Path(proton).parent / "files/lib/wine/i386-windows/ws2_32.dll"


def proton_has_dirt_fix(proton):
    try:
        return DIRT_FIXED in proton_ws2(proton).read_bytes()
    except OSError:
        return False


WINE_DLL_DIRS = ("/lib/wine/i386-windows", "/lib/wine/x86_64-windows", "/lib/wine/aarch64-windows", "/lib/wine",
                 "/lib/wine/fakedlls", "/lib64/wine", "/lib64/wine/fakedlls", "/lib64/wine/x86_64-windows")


def is_wine_dll_link(path):
    try:
        return os.path.islink(path) and os.path.dirname(os.readlink(path)).endswith(WINE_DLL_DIRS)
    except OSError:
        return False


def prefix_ws2(prefix):
    return Path(prefix) / "pfx/drive_c/windows/syswow64/ws2_32.dll"


def is_dirt_stand_in(path):
    try:
        return not path.is_symlink() and DIRT_MARKER in path.read_bytes()
    except OSError:
        return False


def dirt_ws2_wanted(command, env):
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if len(command) < 3 or not prefix or not os.path.isfile(DIRT_WS2):
        return None
    game = DIRT_GAMES.get(os.path.splitext(os.path.basename(command[2]))[0].lower())
    if not game or not dirt_telemetry_on(prefix, game) or proton_has_dirt_fix(command[0]):
        return None
    return prefix if os.path.lexists(prefix_ws2(prefix)) else None


def swap_dirt_ws2(prefix):
    target = prefix_ws2(prefix)
    saved = target.with_name(target.name + DIRT_SAVED)
    data = Path(DIRT_WS2).read_bytes()
    if not is_dirt_stand_in(target):
        if os.path.lexists(saved):
            os.unlink(saved)
        os.replace(target, saved)
    staged = target.with_name(target.name + ".droiddeck-tmp")
    staged.write_bytes(data)
    os.replace(staged, target)


def restore_dirt_ws2(prefix, proton):
    target = prefix_ws2(prefix)
    saved = target.with_name(target.name + DIRT_SAVED)
    own = proton_ws2(proton)
    had_saved = os.path.lexists(saved)
    if had_saved:
        if os.path.lexists(target) and not is_dirt_stand_in(target):
            os.unlink(saved)
            return False
        if not own.is_file() or not is_wine_dll_link(saved) or os.path.realpath(saved) == os.path.realpath(own):
            os.replace(saved, target)
            return True
        os.unlink(saved)
    if own.is_file() and (is_dirt_stand_in(target) or (had_saved and not os.path.lexists(target))):
        link = target.with_name(target.name + ".droiddeck-tmp")
        if os.path.lexists(link):
            os.unlink(link)
        os.symlink(own, link)
        os.replace(link, target)
        return True
    return False


EGO_RESTRICTIONS = "system/hardware_settings_restrictions.xml"
EGO_CORE_RULE = re.compile(r'[ \t]*<restrict_if name="cores" op="(int_[a-z]+)" value="(\d+)">.*?</restrict_if>[ \t]*\r?\n', re.S)
EGO_OPS = {"int_eq": int.__eq__, "int_ne": int.__ne__, "int_ge": int.__ge__, "int_gt": int.__gt__,
           "int_le": int.__le__, "int_lt": int.__lt__}


def windows_core_count(env):
    count = (env.get("WINE_CPU_TOPOLOGY") or "").split(":", 1)[0]
    return int(count) if count.isascii() and count.isdigit() and int(count) > 0 else None


def ego_core_plan(command, env):
    count = windows_core_count(env)
    if not count or len(command) < 3:
        return None
    folder = Path(command[2]).parent
    path = folder / EGO_RESTRICTIONS
    try:
        raw = path.read_bytes()
    except OSError:
        return None
    text = raw.decode("latin-1")
    start, end = text.find("<cpu>"), text.find("</cpu>")
    if start < 0 or end < start:
        return None
    rules = list(EGO_CORE_RULE.finditer(text, start, end))
    if not rules or any(EGO_OPS.get(rule.group(1), lambda a, b: True)(count, int(rule.group(2))) for rule in rules):
        return None
    smaller = [rule for rule in rules if rule.group(1) == "int_eq" and int(rule.group(2)) < count]
    if not smaller:
        return None
    source = max(smaller, key=lambda rule: int(rule.group(2)))
    worker_map = re.search(r'workerMapFile="([^"]+)"', source.group(0))
    if worker_map and not (folder / worker_map.group(1)).is_file():
        return None
    plan = source.group(0).replace('value="%s"' % source.group(2), 'value="%d"' % count, 1)
    saved = path.with_name(path.name + DIRT_SAVED)
    if not os.path.lexists(saved):
        saved.write_bytes(raw)
    handle, staged = tempfile.mkstemp(prefix=path.name + ".", suffix=".droiddeck-tmp", dir=str(path.parent))
    try:
        with os.fdopen(handle, "wb") as out:
            out.write((text[:source.end()] + plan + text[source.end():]).encode("latin-1"))
        os.replace(staged, path)
    except BaseException:
        if os.path.lexists(staged):
            os.unlink(staged)
        raise
    return "%s had no thread plan for %d cores; added a copy of its %s-core plan" % (EGO_RESTRICTIONS, count, source.group(2))


def run_forwarding_signals(launch, launch_env, after=None):
    """Starts the launch as exec would (inherited fds and signal dispositions) and waits for it, passing SIGTERM, SIGINT
    and SIGHUP on; a signal that arrives before the child exists is sent once it does. [after] runs once the child has
    started and ended (not when it could not start). Returns (process, exit code)."""
    state = {"process": None, "pending": []}
    # A signal the launch chain ignores (nohup's SIGHUP) stays ignored for the game, as with exec.
    forwarded = [s for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP) if signal.getsignal(s) != signal.SIG_IGN]

    def forward(signum, frame):
        if state["process"] is None:
            state["pending"].append(signum)
            return
        try:
            state["process"].send_signal(signum)
        except OSError:
            pass

    previous = {signum: signal.signal(signum, forward) for signum in forwarded}
    try:
        if state["pending"]:
            return None, 128 + state["pending"][0]
        process = subprocess.Popen(launch, env=launch_env, close_fds=False, restore_signals=False)
        state["process"] = process
        try:
            for signum in state["pending"]:
                forward(signum, None)
            code = process.wait()
        finally:
            if after:
                try:
                    after()
                except OSError as error:
                    print("droiddeck-game-env: DiRT telemetry fix: prefix ws2_32 not put back (%s); the next launch does it"
                          % error, file=sys.stderr)
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)
    return process, (128 - code if code < 0 else code)


def start(launch, launch_env, digest, after=None, finished=None):
    """Runs the launch. A game launch (finished) waits for it to log its exit; everything else is exec'd."""
    if not (after or digest or finished):
        return os.execvpe(launch[0], launch, launch_env)
    began = time.monotonic()
    process, code = run_forwarding_signals(launch, launch_env, after)
    if digest and code == 0:
        record_install_scripts(digest, launch_env)
    if finished and process is not None:
        try:
            finished(process.returncode, time.monotonic() - began)
        except Exception as error:
            print("droiddeck-game-env: game exit not logged (%s)" % error, file=sys.stderr)
    return code


LAUNCH_WRAPPERS = ("pw-audio-namespace", "steam-launch-wrapper")


def proc_parent(proc, pid):
    with open(os.path.join(proc, str(pid), "stat"), encoding="utf-8", errors="replace") as source:
        return int(source.read().rsplit(")", 1)[1].split()[1])


def proc_name(proc, pid):
    with open(os.path.join(proc, str(pid), "cmdline"), "rb") as source:
        return os.path.basename(source.read().split(b"\0", 1)[0].decode("utf-8", "replace"))


def launch_chain_oom(proc="/proc", start=None, levels=6):
    # Steam starts every game as steam-launch-wrapper --oom-score-adjust 900, which execs
    # pw-audio-namespace -> reaper -> this compat tool. On Android those three keep 900 and are
    # the first victims when memory runs short; their SIGKILL makes Steam drop the game
    # ("Killed", "game stopped") while the game lives on. Lower them to 0 like the game itself:
    # only the ancestors above 0 up to Steam's launch wrapper, never steam, nothing without a wrapper.
    pid = os.getppid() if start is None else start
    chain = []
    for _ in range(levels):
        if pid <= 1:
            return [], []
        try:
            name = proc_name(proc, pid)
            if name == "steam":
                return [], []
            path = os.path.join(proc, str(pid), "oom_score_adj")
            with open(path, encoding="utf-8") as source:
                value = int(source.read().strip() or 0)
            if value <= 0:
                return [], []
            chain.append((pid, name, value, path))
            if name in LAUNCH_WRAPPERS:
                break
            pid = proc_parent(proc, pid)
        except (OSError, ValueError, IndexError):
            return [], []
    else:
        return [], []
    done, failed = [], []
    for pid, name, value, path in chain:
        try:
            with open(path, "w", encoding="utf-8") as target:
                target.write("0\n")
            done.append("%d %s %d" % (pid, name, value))
        except OSError as error:
            failed.append("%d %s %d (%s)" % (pid, name, value, error.strerror or error))
    print("droiddeck-game-env: oom_score_adj 0 for the Steam launch chain: %s%s"
          % (", ".join(done) or "none", "; not set: " + ", ".join(failed) if failed else ""), file=sys.stderr)
    return done, failed


def main():
    command = sys.argv[1:]
    if not command:
        return 2
    try:
        with open("/proc/self/oom_score_adj", "w", encoding="utf-8") as adj:
            adj.write("0\n")
    except OSError:
        pass
    launch_chain_oom()
    env = game_gpu(os.environ.copy())
    app_id = game_id(env)
    path = Path.home() / ".config/droiddeck/game-environment.json"
    config = None
    if app_id:
        try:
            with path.open(encoding="utf-8") as source:
                config = json.load(source)
        except FileNotFoundError:
            pass
        except (OSError, ValueError):
            config = False
    env = game_driver(command, env, game_driver_choice(config, app_id))
    driver_files = (env.get("VK_DRIVER_FILES"), env.get("VK_ICD_FILENAMES"))
    mic_enabled = env.get("BL_MIC_ENABLED")
    debug_dir = env.get("BL_DEBUG_DIR", "")
    scripts = mark_install_scripts(command, env)
    if scripts and install_scripts_done(scripts, env):
        print("droiddeck-game-env: install scripts already run in this prefix; evaluator skipped", file=sys.stderr)
        return 0
    try:
        digest = scripts_digest(scripts) if scripts else None
    except OSError:
        digest = None
    dirt_prefix = None
    if app_id:
        gl_default = gl_vsync(env)
        waiting = len(command) > 1 and command[1] == "waitforexitandrun"
        if waiting:
            game_images(env)
        fixes = {}
        mali = None
        if waiting:
            command = skip_red_launcher(command)
            ubisoft_overlay_off(env)
            fixes, extra, notes = engine_fixes(command[2], command[3:]) if len(command) > 2 else ({}, [], [])
            if not gl_default:
                fixes.pop("vblank_mode", None)
            for note in notes:
                print("droiddeck-game-env: " + note, file=sys.stderr)
            command += extra
            mali = mali_defaults()
            if mali:
                try:
                    values, notes, found = mali["recipe"](command, env, config if isinstance(config, dict) else None, app_id)
                    fixes = mali["merge"](fixes, values)
                    prefix_note = mali["apply_prefix"](found, env)
                    for note in notes + ([prefix_note] if prefix_note else []):
                        print("droiddeck-game-env: " + note, file=sys.stderr)
                except Exception as error:
                    print("droiddeck-game-env: Mali defaults not applied (%s)" % error, file=sys.stderr)
            components = win_components(env.get("STEAM_COMPAT_DATA_PATH", ""), app_id)
            if components:
                own = fixes.get("WINEDLLOVERRIDES")
                fixes["WINEDLLOVERRIDES"] = components + ";" + own if own else components
            dirt_prefix = dirt_ws2_wanted(command, env)
            if dirt_prefix:
                own = fixes.get("WINEDLLOVERRIDES")
                fixes["WINEDLLOVERRIDES"] = own + ";ws2_32=n,b" if own else "ws2_32=n,b"
        try:
            if config is False:
                raise ValueError("unreadable configuration")
            if config is None:
                if waiting:
                    env = apply_config(env, {"version": 1}, app_id, fixes)
            elif waiting:
                if "vblank_mode" in config.get("shared", {}):
                    fixes.pop("vblank_mode", None)
                env = apply_config(env, config, app_id, fixes)
            else:
                env = apply_config(env, sync_config(config, app_id), app_id)
        except (OSError, ValueError, TypeError, AttributeError):
            print("droiddeck-game-env: invalid configuration; using inherited environment", file=sys.stderr)
        env.pop(GAME_DRIVER, None)
        if waiting and (env.get("VK_DRIVER_FILES"), env.get("VK_ICD_FILENAMES")) != driver_files:
            print("droiddeck-game-env: game driver: %s; a game or env-default setting of VK_DRIVER_FILES/VK_ICD_FILENAMES "
                  "(replaces the line above)" % (env.get("VK_DRIVER_FILES") or env.get("VK_ICD_FILENAMES")
                                                 or "the Vulkan loader's default"), file=sys.stderr)
        if waiting:
            env = ray_tracing(env, own_keys(config, app_id), app_id)
            before_debug = env
            env = apply_game_debug_logs(env, config if isinstance(config, dict) else {}, debug_dir)
            if env is not before_debug:
                print("droiddeck-game-env: game debug logs enabled for this launch", file=sys.stderr)
            env = game_logs(env, heavy=env is not before_debug, own=own_keys(config, app_id))
            if mali:
                try:
                    note = mali["fex_patch"](command, env, app_id)
                except Exception as error:
                    note = "FEX arm64ec: not changed (%s)" % error
                if note:
                    print("droiddeck-game-env: " + note, file=sys.stderr)
        if gl_default and env.get("vblank_mode") == "0":
            print("droiddeck-game-env: OpenGL does not wait for the screen refresh (vblank_mode=0)", file=sys.stderr)
    if app_id and len(command) > 1 and command[1] == "waitforexitandrun":
        command = offline_without_anticheat(command, env)
    if mic_enabled == "0":
        env["AUDIO_DIRECT_MIC"] = "0"
    env = directaudio_settings(env)
    env = vram_cap(env)
    env = force_ssbs(command, env)
    game_cores(env)
    cpu_topology(env, command)
    if app_id and len(command) > 2 and command[1] == "waitforexitandrun":
        try:
            note = ego_core_plan(command, env)
        except OSError as error:
            note = "no thread plan added for this core count (%s)" % error
        if note:
            print("droiddeck-game-env: " + note, file=sys.stderr)
    try:
        xbox = runpy.run_path(str(Path(__file__).with_name("droiddeck-xbox")))
    except Exception as error:
        print("droiddeck-game-env: Xbox support unavailable (%s); stock launch" % error, file=sys.stderr)
        xbox = {"launch": lambda command, env: None}
    try:
        xbox_result = xbox["launch"](command, env)
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        print("droiddeck-game-env: Xbox launch could not start (%s)" % error, file=sys.stderr)
        return 1
    if xbox_result is not None:
        return xbox_result
    after = None
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if app_id and prefix and len(command) > 1 and command[1] == "waitforexitandrun":
        try:
            if dirt_prefix:
                after = lambda: restore_dirt_ws2(dirt_prefix, command[0])
                swap_dirt_ws2(dirt_prefix)
                print("droiddeck-game-env: DiRT telemetry fix: ws2_32 stand-in in the prefix until the game exits",
                      file=sys.stderr)
            elif restore_dirt_ws2(prefix, command[0]):
                print("droiddeck-game-env: DiRT telemetry fix: put the prefix's own ws2_32 back", file=sys.stderr)
        except OSError as error:
            print("droiddeck-game-env: DiRT telemetry fix not applied (%s)" % error, file=sys.stderr)
            if after:
                after = None
                try:
                    restore_dirt_ws2(dirt_prefix, command[0])
                except OSError as undo:
                    print("droiddeck-game-env: DiRT telemetry fix: prefix ws2_32 not put back (%s); Wine uses its own copy "
                          "and the next launch puts the file back" % undo, file=sys.stderr)
    sync = load_sync()
    launch, launch_env = select_sync(command, env, sync)
    finished = None
    if app_id and len(command) > 1 and command[1] == "waitforexitandrun":
        finished = lambda returncode, seconds: game_finished(launch_env, returncode, seconds)
    if launch[0] != command[0]:
        try:
            return start(launch, launch_env, digest, after, finished)
        except OSError as error:
            print("droiddeck-game-env: %s could not start (%s); stock launch" % (launch[0], error), file=sys.stderr)
            launch, launch_env = command, without_pack(launch_env, env)
            record_stock(sync, launch, launch_env)
    try:
        return start(launch, launch_env, digest, after, finished)
    except OSError:
        if after:
            try:
                after()
            except OSError as error:
                print("droiddeck-game-env: DiRT telemetry fix: prefix ws2_32 not put back (%s); the next launch does it" % error,
                      file=sys.stderr)
        raise


if __name__ == "__main__":
    sys.exit(main())
