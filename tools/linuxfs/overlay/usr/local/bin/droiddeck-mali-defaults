APPENDED = ("DXVK_CONFIG", "WINEDLLOVERRIDES")

# ---- env defaults manifest (the app's online updater, session/MaliEnvDefaults.kt) ----
# The recipes above are the built-in fallback. The APK bundles a manifest (MANIFEST_BUNDLED, staged by the app) and the
# app's "Check for updates" can install a newer one from the fork's GitHub release (MANIFEST_ONLINE, written by the app).
# The newest valid one wins; an invalid file is ignored with a log line, so a bad download never breaks a launch. The
# rules below are the same as MaliEnvDefaults.kt's (one shared test manifest checks both).
MANIFEST_SCHEMA = "droiddeck-mali-env-defaults/1"
MANIFEST_BUNDLED = MALI_DATA + "/env-defaults.json"
MANIFEST_ONLINE = ".config/droiddeck/mali-env-defaults.json"
MANIFEST_VERSION = re.compile(r"[0-9]{4}\.[0-9]{2}\.[0-9]{2}\.[0-9]{1,3}")
GAME_KEY = re.compile(r"steam:[1-9][0-9]{0,9}|[a-z]{2,16}:[A-Za-z0-9._-]{1,128}")
ENV_NAME = re.compile(r"[A-Z][A-Z0-9_]{0,63}")
ENV_PREFIXES = ("MALI_COMPAT_", "MALI_WSI_", "DXVK_", "VKD3D_", "PROTON_", "WINE", "FEX_", "BL_")
ENV_NAMES = ("MALI_DEBUG_CONFIG",)
# Names that load code or move the game's files, and the defaults' own switches: never from a manifest.
ENV_DENIED = frozenset((
    "WINEPREFIX", "WINESERVER", "WINELOADER", "WINEDLLPATH", "WINEARCH", "PROTON_LOG_DIR", "PROTONPATH",
    "FEX_ROOTFS", "FEX_THUNKHOSTLIBS", "FEX_THUNKGUESTLIBS", "FEX_THUNKCONFIG", "FEX_APP_CONFIG", "FEX_APP_CONFIG_LOCATION",
    "FEX_APP_DATA_LOCATION", "FEX_SERVERSOCKETPATH", "DXVK_CONFIG_FILE", "DXVK_LOG_PATH", "VKD3D_LOG_FILE",
    SWITCH, "BL_DEBUG_DIR",
))
PATH_ROOTS = ("/usr/share/droiddeck-mali/", "Z:/usr/share/droiddeck-mali/")
PREFIX_ACTIONS = ("wpad-off",)
MAX_GAMES = 256
MAX_KEYS = 64
MAX_VALUE = 1024


def check_env(name, value):
    """Why a manifest env entry is refused, or None."""
    if not isinstance(name, str) or not ENV_NAME.fullmatch(name):
        return "bad name %r" % (name,)
    if name in ENV_DENIED or not (name in ENV_NAMES or name.startswith(ENV_PREFIXES)):
        return "%s is not allowed in env defaults" % name
    if not isinstance(value, str) or len(value) > MAX_VALUE or any(ord(c) < 0x20 or ord(c) == 0x7f for c in value):
        return "%s: bad value" % name
    if value.startswith("/") or re.match(r"[A-Za-z]:[/\\]", value):
        if "\\" in value or "/../" in value + "/" or not value.startswith(PATH_ROOTS):
            return "%s: a path outside /usr/share/droiddeck-mali" % name
    return None


def parse_manifest(data):
    """(version, {key: Recipe}) of a manifest's JSON text; ValueError with the reason when it is refused."""
    try:
        manifest = json.loads(data)
    except ValueError as error:
        raise ValueError("not JSON (%s)" % error)
    if not isinstance(manifest, dict) or manifest.get("schema") != MANIFEST_SCHEMA:
        raise ValueError("not a %s manifest" % MANIFEST_SCHEMA)
    version = manifest.get("version")
    if not isinstance(version, str) or not MANIFEST_VERSION.fullmatch(version):
        raise ValueError("bad version %r" % (version,))
    games = manifest.get("games")
    if not isinstance(games, dict) or len(games) > MAX_GAMES:
        raise ValueError("games must be an object of at most %d entries" % MAX_GAMES)
    recipes = {}
    for key, game in games.items():
        if not isinstance(key, str) or not GAME_KEY.fullmatch(key):
            raise ValueError("bad game key %r" % (key,))
        if key.startswith("steam:") and int(key[6:]) >= 2**31:
            raise ValueError("%s is a Steam shortcut id, not a store game's stable id" % key)
        if not isinstance(game, dict):
            raise ValueError("%s: not an object" % key)
        title, env, note = game.get("title"), game.get("env"), game.get("note")
        if not isinstance(title, str) or not title or len(title) > 128:
            raise ValueError("%s: bad title" % key)
        if not isinstance(env, dict) or len(env) > MAX_KEYS:
            raise ValueError("%s: env must be an object of at most %d keys" % (key, MAX_KEYS))
        for name, value in env.items():
            problem = check_env(name, value)
            if problem:
                raise ValueError("%s: %s" % (key, problem))
        if note is not None and (not isinstance(note, str) or len(note) > 512):
            raise ValueError("%s: bad note" % key)
        prefix = game.get("prefix", [])
        if not isinstance(prefix, list) or any(action not in PREFIX_ACTIONS for action in prefix):
            raise ValueError("%s: prefix actions are %s" % (key, ", ".join(PREFIX_ACTIONS)))
        if not isinstance(game.get("evidence"), str) or not game["evidence"]:
            raise ValueError("%s: evidence missing" % key)
        for pending in game.get("pending", []):
            if not isinstance(pending, dict) or not isinstance(pending.get("env"), dict):
                raise ValueError("%s: bad pending entry" % key)
            for name, value in pending["env"].items():
                problem = check_env(name, value)
                if problem:
                    raise ValueError("%s (pending): %s" % (key, problem))
        recipes[key] = Recipe(title, dict(env), note, wpad="wpad-off" in prefix)
    return version, recipes


def version_tuple(version):
    return tuple(int(part) for part in version.split("."))


def load_manifest(path):
    """(version, recipes) of a manifest file, None when there is none; ValueError when it is refused."""
    try:
        with open(path, "rb") as source:
            data = source.read(1 << 20)
    except FileNotFoundError:
        return None
    except OSError as error:
        raise ValueError(str(error))
    return parse_manifest(data.decode("utf-8", errors="strict"))


_ACTIVE = {}


def active_recipes(home=None, bundled=MANIFEST_BUNDLED):
    """(recipes, label, problems): the newest valid manifest of the app's online copy and the bundled one, else the
    built-in recipes. label names what was used, for the game's log and the problem report."""
    online = Path(home or os.environ.get("HOME", "/root")) / MANIFEST_ONLINE
    cache_key = (str(online), bundled)
    if cache_key in _ACTIVE:
        return _ACTIVE[cache_key]
    best, problems = None, []
    for path, source in ((online, "downloaded"), (Path(bundled), "bundled")):
        try:
            loaded = load_manifest(path)
        except (ValueError, UnicodeDecodeError) as error:
            problems.append("%s env defaults %s ignored (%s)" % (source, path, error))
            continue
        if loaded and (best is None or version_tuple(loaded[0]) > version_tuple(best[0])):
            best = (loaded[0], loaded[1], source)
    result = (best[1], "env defaults %s (%s)" % (best[0], best[2]), problems) if best else \
        (RECIPES, "env defaults built-in", problems)
    _ACTIVE[cache_key] = result
    return result


def say(note):
    print("droiddeck-game-env: " + note, file=sys.stderr)


def switch_off(name, env, config=None, app_id=None):
    value = env.get(name)
    if isinstance(config, dict):
        shared = config.get("shared")
        if isinstance(shared, dict) and name in shared:
            value = shared[name]
        games = config.get("games")
        game = games.get(app_id) if isinstance(games, dict) and app_id else None
        if isinstance(game, dict) and name in game:
            value = game[name]
    return isinstance(value, str) and value.strip().lower() in ("0", "off", "false", "no")


def steam_app(env):
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    value = prefix.rsplit("/", 1)[-1] if prefix else ""
    if not re.fullmatch(r"[1-9][0-9]{0,9}", value) or int(value) >= 2**31:
        return None
    return value


def store_game(command):
    for raw in command[2:3]:
        arg = raw.strip().strip('"').strip("'").replace("\\", "/")
        if "/" not in arg:
            continue
        folder = Path(arg).parent
        for _ in range(SIDECAR_DEPTH):
            try:
                sidecar = json.loads((folder / SIDECAR).read_text(encoding="utf-8"))
            except (OSError, ValueError):
                sidecar = None
            if isinstance(sidecar, dict) and isinstance(sidecar.get("store"), str) and isinstance(sidecar.get("id"), str) \
                    and sidecar["store"] and sidecar["id"]:
                return sidecar["store"] + ":" + sidecar["id"]
            if folder.parent == folder:
                break
            folder = folder.parent
    return None


def game_key(command, env, recipes=None):
    app = steam_app(env)
    if app and "steam:" + app in (RECIPES if recipes is None else recipes):
        return "steam:" + app
    return store_game(command) if len(command) > 2 else None


def on_bridge(env):
    return env.get("ENABLE_MALI_COMPAT") == "1" and bool(env.get("VK_DRIVER_FILES"))


def user_keys(config, app_id):
    """The names the user set: the game's own entry and the user's shared settings (the app publishes their names as
    userShared, because its published shared block also holds the app's built-in defaults). Those always win."""
    if not isinstance(config, dict):
        return set()
    names = set()
    shared = config.get("userShared")
    if isinstance(shared, list):
        names.update(name for name in shared if isinstance(name, str))
    games = config.get("games")
    game = games.get(app_id) if isinstance(games, dict) and app_id else None
    if isinstance(game, dict):
        names.update(game)
    return names


def recipe(command, env, config=None, app_id=None, home=None, bundled=MANIFEST_BUNDLED):
    """(values, notes, recipe) for this game on the bridge, or ({}, [], None). A key the user set is left out, so the
    user's value stands (also over the bridge's own DXVK_CONFIG append)."""
    if not on_bridge(env) or switch_off(SWITCH, env, config, app_id):
        return {}, [], None
    recipes, label, problems = active_recipes(home, bundled)
    key = game_key(command, env, recipes)
    found = recipes.get(key) if key else None
    if found is None:
        return {}, problems, None
    mine = user_keys(config, app_id)
    values = {name: value for name, value in found.env.items() if name not in mine}
    if "DXVK_CONFIG" in values:
        own = env.get("DXVK_CONFIG", "").strip().rstrip(";").strip()
        values["DXVK_CONFIG"] = own + "; " + values["DXVK_CONFIG"] if own else values["DXVK_CONFIG"]
    notes = ["Mali defaults for %s (%s), %s" % (found.title, key, label)] + problems
    kept = sorted(set(found.env) & mine)
    if kept:
        notes.append("%s: your own %s kept over the defaults" % (found.title, ", ".join(kept)))
    if found.note:
        notes.append("%s: %s" % (found.title, found.note))
    return values, notes, found


def merge(fixes, values):
    result = dict(fixes)
    for name, value in values.items():
        if name == "WINEDLLOVERRIDES" and result.get(name):
            value = result[name] + ";" + value
        result[name] = value
    return result


WPAD_KEY = "[Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings\\\\Connections]"
# DefaultConnectionSettings version 0x46 with flags 0x01 (direct, no auto-detect): without the key winhttp auto-detects
# WPAD, and the Easy Anti-Cheat thread unloads winhttp with its NotifyAddrChange still pending (the menu-freeze death).
WPAD_VALUE = '"DefaultConnectionSettings"=hex:46,00,00,00,00,00,00,00,01' + ",00" * 47


def wpad_off(prefix, now=None):
    """Writes the no-auto-detect proxy key into the prefix's user.reg once. Returns a note or None."""
    reg = Path(prefix) / "pfx" / "user.reg"
    try:
        text = reg.read_text(encoding="utf-8", errors="surrogateescape")
    except FileNotFoundError:
        return "proxy auto-detect: no user.reg yet, the key is written at the next launch"
    except OSError as error:
        return "proxy auto-detect left on (%s)" % error
    if WPAD_KEY.lower() in text.lower():
        return None
    block = "\n%s %d\n%s\n" % (WPAD_KEY, int(now if now is not None else time.time()), WPAD_VALUE)
    staged = reg.with_name(reg.name + ".droiddeck-tmp")
    try:
        staged.write_text(text.rstrip("\n") + "\n" + block, encoding="utf-8", errors="surrogateescape")
        os.chmod(staged, reg.stat().st_mode & 0o7777)
        os.replace(staged, reg)
    except OSError as error:
        try:
            staged.unlink()
        except OSError:
            pass
        return "proxy auto-detect left on (%s)" % error
    return "proxy auto-detect off in this prefix (Internet Settings\\Connections, no WPAD)"


def apply_prefix(found, env):
    if found is None or not found.wpad:
        return None
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    return wpad_off(prefix) if prefix else None


FEX_DLL = "files/lib/wine/aarch64-windows/libarm64ecfex.dll"
FEX_PATCHED = "/usr/local/lib/droiddeck-fex-arm64ec/libarm64ecfex.dll"
FEX_PATCHED_MD5 = "a2448b03b9ca32b6a641d687e9773074"
FEX_BASE = b"FEX-2610-101-g1c4f04b"
FEX_BASE_MD5 = ("863695500852d6df6a7b6b971893b4c1",)
FEX_VERSION = re.compile(rb"FEX-\d{4}(?:\.\d+)?(?:-\d+-g[0-9a-f]{6,})?")


def components_dir():
    return Path(os.environ.get("HOME", "/root")) / ".local/share/droiddeck-components"


def md5_of(path):
    try:
        digest = hashlib.md5(usedforsecurity=False)
    except TypeError:
        digest = hashlib.md5()
    with open(path, "rb") as source:
        for block in iter(lambda: source.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def fex_version(path):
    try:
        found = FEX_VERSION.findall(Path(path).read_bytes())
    except OSError:
        return None
    return max(found, key=len) if found else None


def proton_build(tool):
    try:
        with open(tool / "version", encoding="utf-8", errors="replace") as f:
            parts = f.readline().split()
    except OSError:
        return ""
    return parts[1] if len(parts) > 1 else (parts[0] if parts else "")


def components_choice(tool, app_id, folder):
    """True when the app's Components screen manages this Proton's FEX DLL for this game."""
    build = proton_build(tool)
    try:
        with open(folder / "desired.tsv", encoding="utf-8", errors="replace") as f:
            for line in f:
                fields = line.rstrip("\n").split("\t")
                if (len(fields) == 7 and fields[0] in ("*", app_id) and fields[1] == tool.name and fields[2] == build
                        and fields[3] == "fex" and fields[4] == FEX_DLL):
                    return True
    except OSError:
        pass
    return False


def place(source, target):
    staged = target.with_name(target.name + ".bl-new")
    shutil.copyfile(source, staged)
    os.chmod(staged, 0o644)
    os.replace(staged, target)


def fex_patch(command, env, app_id=None, folder=None, patched=FEX_PATCHED):
    """Puts the patched libarm64ecfex.dll into an ARM64 Proton before a game starts, and puts it back after a Proton
    update or verify replaced it. Only over a stock DLL of the FEX build the patch was made from; a game with
    BL_FEX_ARM64EC_PATCH=0 gets the stock DLL back. Returns a note or None."""
    if len(command) < 2 or command[1] != "waitforexitandrun":
        return None
    tool = Path(command[0]).parent
    target = tool / FEX_DLL
    if not target.is_file():
        return None
    folder = Path(folder) if folder else components_dir()
    if components_choice(tool, app_id or "", folder):
        return "FEX arm64ec: the Components choice for %s stays" % tool.name
    stock_dir = folder / "fex-arm64ec"
    record = stock_dir / (re.sub(r"[^A-Za-z0-9._+-]+", "_", tool.name) + ".stock")
    try:
        current = md5_of(target)
        if switch_off(FEX_SWITCH, env):
            if current != FEX_PATCHED_MD5:
                return None
            try:
                stock = stock_dir / (record.read_text().strip() + ".dll")
            except OSError:
                stock = None
            if stock is None or not stock.is_file() or md5_of(stock) != stock.stem:
                return "FEX arm64ec: %s=0 but no stock copy of %s's DLL; the patched one stays" % (FEX_SWITCH, tool.name)
            place(stock, target)
            return "FEX arm64ec: stock DLL for this game (%s=0)" % FEX_SWITCH
        if current == FEX_PATCHED_MD5:
            return None
        if current not in FEX_BASE_MD5 and fex_version(target) != FEX_BASE:
            version = fex_version(target)
            return "FEX arm64ec: %s has %s, not the patched DLL's base %s; left as it is" % (
                tool.name, (version or b"an unnamed FEX").decode(), FEX_BASE.decode())
        if not os.path.isfile(patched) or md5_of(patched) != FEX_PATCHED_MD5:
            return "FEX arm64ec: the bundled patched DLL is missing or damaged (%s); stock kept" % patched
        stock_dir.mkdir(parents=True, exist_ok=True)
        stock = stock_dir / (current + ".dll")
        if not stock.is_file() or md5_of(stock) != current:
            place(target, stock)
        record.write_text(current + "\n")
        place(Path(patched), target)
    except OSError as error:
        return "FEX arm64ec: not changed (%s)" % error
    try:
        with open(folder / "reapplied.log", "a", encoding="utf-8") as log:
            log.write("%d\t%s\t1\n" % (time.time(), tool.name))
    except OSError:
        pass
    return "FEX arm64ec: patched DLL put in %s (unaligned-atomic fallback; %s=0 for stock)" % (tool.name, FEX_SWITCH)
