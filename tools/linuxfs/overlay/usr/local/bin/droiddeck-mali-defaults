#!/usr/bin/python3
"""Mali defaults, loaded by droiddeck-game-env: the settings each game needed on the Mali system driver (the bridge)
in the fork's phone runs, and the patched FEX arm64ec DLL.

Games are keyed by their Steam app id or their store id (an Epic AppName from the game folder's store sidecar), never
by the compatdata id of a store game's Steam shortcut, which differs per install. Only a game on the bridge gets its
recipe; the app's own game settings still win key by key (a null value there removes a key). BL_MALI_GAME_DEFAULTS=0
in the session, the shared settings or a game's settings turns the recipes off."""
import hashlib
import json
import os
import re
import shutil
import sys
import time
from pathlib import Path

SWITCH = "BL_MALI_GAME_DEFAULTS"
FEX_SWITCH = "BL_FEX_ARM64EC_PATCH"
SIDECAR = ".droiddeck-store.json"
SIDECAR_DEPTH = 6
MALI_DATA = "/usr/share/droiddeck-mali"
CONTROL_OVERRIDE = MALI_DATA + "/vkd3d-override/control"
WD2_DEBUG_CONFIG = MALI_DATA + "/mali-debug-wd2.config"

DXVK_PACK = {
    "MALI_COMPAT_ASYNC_PSO": "50",
    "MALI_COMPAT_PIPELINE_CACHE": "1",
    "MALI_COMPAT_PIPELINE_CACHE_THREADS": "dxvk-cs",
    "MALI_COMPAT_NOATT_AREA": "4096x4096",
    "MALI_COMPAT_XFB_VS": "1",
}
# The pass-boundary barrier classes that stop the Witcher 3 DX12 terrain flashes and the Control shadow flicker
# (witcher-fbnarrow 11-05, control-flicker-1106); compat layers without MALI_COMPAT_FB_MASK ignore it.
FB_MASK = "0x0d6"
# Ubisoft Connect stalled at the game start with the user-space ntsync (17 % -> 57 %); esync again, Connect quiet.
UBISOFT_SYNC = {"PROTON_NO_NTSYNC": "1", "BL_SYNC": "0", "FEX_SILENTLOG": "1"}


class Recipe:

    def __init__(self, title, env, note=None, wpad=False):
        self.title = title
        self.env = env
        self.note = note
        self.wpad = wpad


