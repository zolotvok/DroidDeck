APPENDED = ("DXVK_CONFIG", "WINEDLLOVERRIDES")


def say(note):
    print("droiddeck-game-env: " + note, file=sys.stderr)


def switch_off(name, env, config=None, app_id=None):
    value = env.get(name)
    if isinstance(config, dict):
        shared = config.get("shared")
        if isinstance(shared, dict) and name in shared:
            value = shared[name]
        games = config.get("games")
        game = games.get(app_id) if isinstance(games, dict) and app_id else None
        if isinstance(game, dict) and name in game:
            value = game[name]
    return isinstance(value, str) and value.strip().lower() in ("0", "off", "false", "no")


def steam_app(env):
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    value = prefix.rsplit("/", 1)[-1] if prefix else ""
    if not re.fullmatch(r"[1-9][0-9]{0,9}", value) or int(value) >= 2**31:
        return None
    return value


def store_game(command):
    for raw in command[2:3]:
        arg = raw.strip().strip('"').strip("'").replace("\\", "/")
        if "/" not in arg:
            continue
        folder = Path(arg).parent
        for _ in range(SIDECAR_DEPTH):
            try:
                sidecar = json.loads((folder / SIDECAR).read_text(encoding="utf-8"))
            except (OSError, ValueError):
                sidecar = None
            if isinstance(sidecar, dict) and isinstance(sidecar.get("store"), str) and isinstance(sidecar.get("id"), str) \
                    and sidecar["store"] and sidecar["id"]:
                return sidecar["store"] + ":" + sidecar["id"]
            if folder.parent == folder:
                break
            folder = folder.parent
    return None


def game_key(command, env):
    app = steam_app(env)
    if app and "steam:" + app in RECIPES:
        return "steam:" + app
    return store_game(command) if len(command) > 2 else None


def on_bridge(env):
    return env.get("ENABLE_MALI_COMPAT") == "1" and bool(env.get("VK_DRIVER_FILES"))


def recipe(command, env, config=None, app_id=None):
    """(values, notes, recipe) for this game on the bridge, or ({}, [], None)."""
    if not on_bridge(env) or switch_off(SWITCH, env, config, app_id):
        return {}, [], None
    key = game_key(command, env)
    found = RECIPES.get(key) if key else None
    if found is None:
        return {}, [], None
    values = dict(found.env)
    if "DXVK_CONFIG" in values:
        own = env.get("DXVK_CONFIG", "").strip().rstrip(";").strip()
        values["DXVK_CONFIG"] = own + "; " + values["DXVK_CONFIG"] if own else values["DXVK_CONFIG"]
    notes = ["Mali defaults for %s (%s)" % (found.title, key)]
    if found.note:
        notes.append("%s: %s" % (found.title, found.note))
    return values, notes, found


def merge(fixes, values):
    result = dict(fixes)
    for name, value in values.items():
        if name == "WINEDLLOVERRIDES" and result.get(name):
            value = result[name] + ";" + value
        result[name] = value
    return result


WPAD_KEY = "[Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings\\\\Connections]"
# DefaultConnectionSettings version 0x46 with flags 0x01 (direct, no auto-detect): without the key winhttp auto-detects
# WPAD, and the Easy Anti-Cheat thread unloads winhttp with its NotifyAddrChange still pending (the menu-freeze death).
WPAD_VALUE = '"DefaultConnectionSettings"=hex:46,00,00,00,00,00,00,00,01' + ",00" * 47


def wpad_off(prefix, now=None):
    """Writes the no-auto-detect proxy key into the prefix's user.reg once. Returns a note or None."""
    reg = Path(prefix) / "pfx" / "user.reg"
    try:
        text = reg.read_text(encoding="utf-8", errors="surrogateescape")
    except FileNotFoundError:
        return "proxy auto-detect: no user.reg yet, the key is written at the next launch"
    except OSError as error:
        return "proxy auto-detect left on (%s)" % error
    if WPAD_KEY.lower() in text.lower():
        return None
    block = "\n%s %d\n%s\n" % (WPAD_KEY, int(now if now is not None else time.time()), WPAD_VALUE)
    staged = reg.with_name(reg.name + ".droiddeck-tmp")
    try:
        staged.write_text(text.rstrip("\n") + "\n" + block, encoding="utf-8", errors="surrogateescape")
        os.chmod(staged, reg.stat().st_mode & 0o7777)
        os.replace(staged, reg)
    except OSError as error:
        try:
            staged.unlink()
        except OSError:
            pass
        return "proxy auto-detect left on (%s)" % error
    return "proxy auto-detect off in this prefix (Internet Settings\\Connections, no WPAD)"


def apply_prefix(found, env):
    if found is None or not found.wpad:
        return None
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    return wpad_off(prefix) if prefix else None


FEX_DLL = "files/lib/wine/aarch64-windows/libarm64ecfex.dll"
FEX_PATCHED = "/usr/local/lib/droiddeck-fex-arm64ec/libarm64ecfex.dll"
FEX_PATCHED_MD5 = "a2448b03b9ca32b6a641d687e9773074"
FEX_BASE = b"FEX-2610-101-g1c4f04b"
FEX_BASE_MD5 = ("863695500852d6df6a7b6b971893b4c1",)
FEX_VERSION = re.compile(rb"FEX-\d{4}(?:\.\d+)?(?:-\d+-g[0-9a-f]{6,})?")


def components_dir():
    return Path(os.environ.get("HOME", "/root")) / ".local/share/droiddeck-components"


def md5_of(path):
    try:
        digest = hashlib.md5(usedforsecurity=False)
    except TypeError:
        digest = hashlib.md5()
    with open(path, "rb") as source:
        for block in iter(lambda: source.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def fex_version(path):
    try:
        found = FEX_VERSION.findall(Path(path).read_bytes())
    except OSError:
        return None
    return max(found, key=len) if found else None


def proton_build(tool):
    try:
        with open(tool / "version", encoding="utf-8", errors="replace") as f:
            parts = f.readline().split()
    except OSError:
        return ""
    return parts[1] if len(parts) > 1 else (parts[0] if parts else "")


def components_choice(tool, app_id, folder):
    """True when the app's Components screen manages this Proton's FEX DLL for this game."""
    build = proton_build(tool)
    try:
        with open(folder / "desired.tsv", encoding="utf-8", errors="replace") as f:
            for line in f:
                fields = line.rstrip("\n").split("\t")
                if (len(fields) == 7 and fields[0] in ("*", app_id) and fields[1] == tool.name and fields[2] == build
                        and fields[3] == "fex" and fields[4] == FEX_DLL):
                    return True
    except OSError:
        pass
    return False


def place(source, target):
    staged = target.with_name(target.name + ".bl-new")
    shutil.copyfile(source, staged)
    os.chmod(staged, 0o644)
    os.replace(staged, target)


def fex_patch(command, env, app_id=None, folder=None, patched=FEX_PATCHED):
    """Puts the patched libarm64ecfex.dll into an ARM64 Proton before a game starts, and puts it back after a Proton
    update or verify replaced it. Only over a stock DLL of the FEX build the patch was made from; a game with
    BL_FEX_ARM64EC_PATCH=0 gets the stock DLL back. Returns a note or None."""
    if len(command) < 2 or command[1] != "waitforexitandrun":
        return None
    tool = Path(command[0]).parent
    target = tool / FEX_DLL
    if not target.is_file():
        return None
    folder = Path(folder) if folder else components_dir()
    if components_choice(tool, app_id or "", folder):
        return "FEX arm64ec: the Components choice for %s stays" % tool.name
    stock_dir = folder / "fex-arm64ec"
    record = stock_dir / (re.sub(r"[^A-Za-z0-9._+-]+", "_", tool.name) + ".stock")
    try:
        current = md5_of(target)
        if switch_off(FEX_SWITCH, env):
            if current != FEX_PATCHED_MD5:
                return None
            try:
                stock = stock_dir / (record.read_text().strip() + ".dll")
            except OSError:
                stock = None
            if stock is None or not stock.is_file() or md5_of(stock) != stock.stem:
                return "FEX arm64ec: %s=0 but no stock copy of %s's DLL; the patched one stays" % (FEX_SWITCH, tool.name)
            place(stock, target)
            return "FEX arm64ec: stock DLL for this game (%s=0)" % FEX_SWITCH
        if current == FEX_PATCHED_MD5:
            return None
        if current not in FEX_BASE_MD5 and fex_version(target) != FEX_BASE:
            version = fex_version(target)
            return "FEX arm64ec: %s has %s, not the patched DLL's base %s; left as it is" % (
                tool.name, (version or b"an unnamed FEX").decode(), FEX_BASE.decode())
        if not os.path.isfile(patched) or md5_of(patched) != FEX_PATCHED_MD5:
            return "FEX arm64ec: the bundled patched DLL is missing or damaged (%s); stock kept" % patched
        stock_dir.mkdir(parents=True, exist_ok=True)
        stock = stock_dir / (current + ".dll")
        if not stock.is_file() or md5_of(stock) != current:
            place(target, stock)
        record.write_text(current + "\n")
        place(Path(patched), target)
    except OSError as error:
        return "FEX arm64ec: not changed (%s)" % error
    try:
        with open(folder / "reapplied.log", "a", encoding="utf-8") as log:
            log.write("%d\t%s\t1\n" % (time.time(), tool.name))
    except OSError:
        pass
    return "FEX arm64ec: patched DLL put in %s (unaligned-atomic fallback; %s=0 for stock)" % (tool.name, FEX_SWITCH)
